<div class="app-container">
    <!-- Banner de Bienvenida -->
    <div class="p-4 p-md-5 mb-4 text-white d-flex align-items-center justify-content-between position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, #E91E63, #C2185B); border-radius: 20px; box-shadow: 0 4px 16px rgba(233, 30, 99, 0.2);">
        <div>
            <h1 class="fw-bold mb-1" style="font-size: 28px; letter-spacing: -0.5px;">Hola, {{#if sessionUser.nombre}}{{sessionUser.nombre}}{{else}}{{sessionUser.usuario}}{{/if}}</h1>
            <p class="mb-0 text-white-50" style="font-size: 15px;">¿Qué vas a pedir hoy?</p>
        </div>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Sección Explorar por categoría -->
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 18px;">Explorar por categoría</h4>
        <p class="text-muted small mb-3">Elige el tipo de comercio que buscas</p>

        <div class="row g-3">
            {{#each listaTiposComercio}}
                <div class="col-6 col-md-4 col-lg-3">
                    <a href="/cliente/home/comercios/{{this._id}}" class="text-decoration-none text-dark">
                        <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4" 
                             style="background: #FFFFFF; border: 1px solid #EEF2F6; transition: transform 0.18s ease, box-shadow 0.18s ease;">
                            <div class="mb-2" style="font-size: 20px; height: 44px; display: flex; align-items: center; justify-content: center;">
                                {{#if this.icono}}
                                    <img src="{{this.icono}}" alt="{{this.nombre}}" style="width: 38px; height: 38px; object-fit: contain;">
                                {{else}}
                                    <div class="logo-square" style="width: 38px; height: 38px; font-size: 14px; margin: 0;">AC</div>
                                {{/if}}
                            </div>
                            <div class="fw-bold text-dark mb-1" style="font-size: 14px;">{{this.nombre}}</div>
                            <div class="text-muted" style="font-size: 12px;">{{this.disponibles}} disponibles</div>
                        </div>
                    </a>
                </div>
            {{else}}
                <div class="col-12 text-center py-4 text-muted">
                    No hay tipos de comercio registrados actualmente.
                </div>
            {{/each}}
        </div>
    </div>

    <!-- Sección Pedidos recientes -->
    {{#if pedidosRecientes.length}}
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0" style="color: #1A1A2E; font-size: 18px;">Pedidos recientes</h4>
            <a href="/cliente/pedidos" class="text-decoration-none" style="color: #E91E63; font-weight: 600; font-size: 13px;">Ver todos →</a>
        </div>

        <div class="d-flex flex-column gap-2">
            {{#each pedidosRecientes}}
                <div class="card border-0 shadow-sm p-3 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 44px; height: 44px; font-size: 14px;">
                                {{#if this.comercioId.logoComercio}}
                                    <img src="{{this.comercioId.logoComercio}}" alt="Logo" style="width: 36px; height: 36px; object-fit: cover; border-radius: 8px;">
                                {{else}}
                                    <div class="logo-square" style="width: 36px; height: 36px; font-size: 13px; margin: 0;">AC</div>
                                {{/if}}
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark" style="font-size: 14.5px;">{{this.comercioId.nombreComercio}}</h6>
                                <small class="text-muted" style="font-size: 12px;">{{formatDate this.createdAt}} · {{this.productos.length}} productos</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold mb-1" style="color: #E91E63; font-size: 14.5px;">RD${{money this.total}}</div>
                            <span class="badge {{statusBadge this.estado}} rounded-pill px-3 py-1" style="font-size: 11px;">{{statusLabel this.estado}}</span>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
</div>
