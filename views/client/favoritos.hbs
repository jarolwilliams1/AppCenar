<div class="app-container" style="max-width: 780px;">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Mis Favoritos</h3>
        <p class="text-muted small mb-0">Comercios que marcaste como favoritos</p>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <div class="d-flex flex-column gap-3">
        {{#each favoritos}}
            <div class="card border-0 shadow-sm p-3 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 48px; height: 48px; font-size: 24px;">
                            {{#if this.logoComercio}}
                                <img src="{{this.logoComercio}}" alt="{{this.nombreComercio}}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 8px;">
                            {{else}}
                                🍕
                            {{/if}}
                        </div>
                        <div>
                            <div class="fw-bold text-dark mb-0" style="font-size: 14.5px;">{{this.nombreComercio}}</div>
                            <small class="text-muted" style="font-size: 12px;">{{this.tipoComercioId.nombre}}</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/cliente/comercio/{{this._id}}" class="btn-pink-primary">
                            Ver menú
                        </a>

                        <form action="/cliente/favoritos/remove/{{this._id}}" method="POST" class="m-0">
                            <button type="submit" class="btn-danger-pill">
                                Remover ❤️
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="card border-0 shadow-sm p-5 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <p class="text-muted mb-3">No tienes comercios favoritos marcados.</p>
                <div>
                    <a href="/cliente/home" class="btn-pink-primary">
                        Explorar Comercios
                    </a>
                </div>
            </div>
        {{/each}}
    </div>
</div>
