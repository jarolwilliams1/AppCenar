<div class="app-container-wide">
    <div class="mb-3">
        <a href="/cliente/comercio/{{comercio._id}}" class="back-link">
            ← Volver al menú
        </a>
    </div>
    
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Confirmar Pedido</h3>
        <p class="text-muted small mb-0">Selecciona tu dirección de entrega y revisa los montos</p>
    </div>

    <form action="/cliente/crear-pedido" method="POST">
        <input type="hidden" name="comercioId" value="{{comercio._id}}">
        <input type="hidden" name="productIds" value="{{productIds}}">

        <div class="row g-4">
            <!-- Selección de dirección -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0" style="color: #1A1A2E; font-size: 15px;">📍 Dirección de entrega</h6>
                        <a href="/cliente/direcciones?nueva=1" class="btn-pink-primary" style="padding: 4px 12px; font-size: 12px;">
                            + Nueva dirección
                        </a>
                    </div>

                    {{#if tienedirecciones}}
                        <div class="d-flex flex-column gap-2">
                            {{#each direcciones}}
                                <label class="card p-3 rounded-3 d-flex flex-row align-items-center gap-3 border" style="cursor: pointer; background: #FAFAFA;">
                                    <input type="radio" name="direccionId" value="{{this._id}}" class="form-check-input mt-0" required {{#if @first}}checked{{/if}}>
                                    <div>
                                        <div class="fw-semibold text-dark" style="font-size: 13.5px;">{{this.nombre}}</div>
                                        <small class="text-muted" style="font-size: 12px;">{{this.descripcion}}</small>
                                    </div>
                                </label>
                            {{/each}}
                        </div>
                    {{else}}
                        <div class="alert alert-light border text-center my-3 rounded-3 py-4">
                            <p class="mb-2 fw-semibold text-dark" style="font-size: 13.5px;">No tienes ninguna dirección registrada.</p>
                            <p class="small text-muted mb-3">Para poder confirmar tu pedido, necesitas agregar al menos una dirección de entrega.</p>
                            <a href="/cliente/direcciones?nueva=1" class="btn-pink-primary">
                                Registrar una dirección ahora
                            </a>
                        </div>
                    {{/if}}
                </div>

                <!-- Productos en el pedido -->
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <h6 class="fw-bold mb-3" style="color: #1A1A2E; font-size: 15px;">Platos seleccionados ({{productos.length}})</h6>
                    <div class="d-flex flex-column gap-2">
                        {{#each productos}}
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 40px; height: 40px; font-size: 20px;">
                                        {{#if this.foto}}
                                            <img src="{{this.foto}}" alt="{{this.nombre}}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
                                        {{else}}
                                            🍕
                                        {{/if}}
                                    </div>
                                    <div>
                                        <div class="fw-semibold small text-dark">{{this.nombre}}</div>
                                        <small class="text-muted" style="font-size: 11.5px;">1 unidad</small>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark" style="font-size: 13.5px;">RD${{money this.precio}}</span>
                            </div>
                        {{/each}}
                    </div>
                </div>
            </div>

            <!-- Panel de Resumen de Totales e ITBIS -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4 rounded-4 sticky-top" style="top: 90px; background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <!-- Comercio Info -->
                    <div class="d-flex align-items-center gap-3 pb-3 mb-3 border-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light" style="width: 44px; height: 44px; font-size: 22px;">
                            {{#if comercio.logoComercio}}
                                <img src="{{comercio.logoComercio}}" alt="{{comercio.nombreComercio}}" style="width: 44px; height: 44px; object-fit: cover; border-radius: 50%;">
                            {{else}}
                                🏪
                            {{/if}}
                        </div>
                        <div>
                            <div class="fw-bold mb-0 text-dark" style="font-size: 14.5px;">{{comercio.nombreComercio}}</div>
                            <small class="text-muted" style="font-size: 12px;">Pedido directo</small>
                        </div>
                    </div>

                    <!-- Detalle de montos -->
                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex justify-content-between text-muted" style="font-size: 13.5px;">
                            <span>Subtotal:</span>
                            <span class="fw-semibold text-dark">RD${{money subtotal}}</span>
                        </div>

                        <div class="d-flex justify-content-between text-muted" style="font-size: 13.5px;">
                            <span>ITBIS ({{itbisPorcentaje}}%):</span>
                            <span class="fw-semibold text-dark">RD${{money itbisMonto}}</span>
                        </div>

                        <hr class="my-2">

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold" style="color: #1A1A2E; font-size: 15px;">Total a pagar:</span>
                            <span class="fw-bold" style="color: #E91E63; font-size: 20px;">RD${{money total}}</span>
                        </div>
                    </div>

                    <!-- Botón de confirmación -->
                    {{#if tienedirecciones}}
                        <button type="submit" class="btn-pink-primary w-100 py-3" style="font-size: 15px; border-radius: 12px;">
                            Pedir ahora
                        </button>
                    {{else}}
                        <button type="button" class="btn-cancel-custom w-100 py-3 text-center" disabled style="font-size: 13.5px;">
                            Agrega una dirección para pedir
                        </button>
                    {{/if}}
                </div>
            </div>
        </div>
    </form>
</div>
