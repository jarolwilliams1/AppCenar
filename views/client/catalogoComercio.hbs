<div class="app-container">
    <!-- Encabezado del Comercio -->
    <div class="mb-3">
        <a href="/cliente/home" class="back-link">
            ← Volver
        </a>
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">{{comercio.nombreComercio}}</h3>
        <p class="text-muted small mb-4">Selecciona los productos para tu pedido</p>
    </div>

    <div class="row g-4">
        <!-- Catálogo de Productos Agrupados -->
        <div class="col-lg-8">
            {{#each categorias}}
                <div class="mb-4">
                    <h5 class="fw-bold mb-3" style="color: #1A1A2E; font-size: 16px;">{{this.nombre}}</h5>

                    <div class="d-flex flex-column gap-2">
                        {{#each this.productos}}
                            <div class="card border-0 shadow-sm p-3 rounded-4 product-card" id="card-prod-{{this._id}}"
                                 style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                                <div class="d-flex justify-content-between align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 52px; height: 52px; flex-shrink: 0; overflow: hidden; font-size: 14px;">
                                            {{#if this.foto}}
                                                 <img src="{{this.foto}}" alt="{{this.nombre}}" style="width: 100%; height: 100%; object-fit: cover;">
                                            {{else}}
                                                 <div class="logo-square" style="width: 40px; height: 40px; font-size: 14px; margin: 0;">AC</div>
                                            {{/if}}
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark mb-0" style="font-size: 14.5px;">{{this.nombre}}</div>
                                            <div class="text-muted small mb-1" style="font-size: 12px;">{{this.descripcion}}</div>
                                            <div class="fw-bold" style="color: #E91E63; font-size: 14px;">RD${{money this.precio}}</div>
                                        </div>
                                    </div>
                                    <div>
                                        <button type="button" 
                                                class="btn-pink-primary" 
                                                id="btn-add-{{this._id}}"
                                                style="padding: 6px 14px; font-size: 12.5px;"
                                                onclick="agregarAlPedido('{{this._id}}', '{{this.nombre}}', {{this.precio}}, '{{this.foto}}')">
                                            + Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{else}}
                <div class="card border-0 shadow-sm p-5 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <p class="text-muted mb-0">Este comercio aún no tiene productos disponibles.</p>
                </div>
            {{/each}}
        </div>

        <!-- Panel Lateral "Mi Pedido" -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 sticky-top" style="top: 84px; background: #FFFFFF; border: 1px solid #EEF2F6;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold mb-0" style="color: #1A1A2E; font-size: 15px;">Mi Pedido</h6>
                    <span class="badge bg-light text-dark" id="cart-count">0 items</span>
                </div>

                <!-- Empty State -->
                <div id="cart-empty" class="text-center py-5">
                    <p class="text-muted mb-0" style="font-size: 13.5px;">Tu pedido está vacío</p>
                </div>

                <!-- Cart Items Container -->
                <div id="cart-items" class="d-flex flex-column gap-2 mb-3" style="display: none !important;">
                </div>

                <!-- Resumen Subtotal y Botón Continuar -->
                <div id="cart-summary" style="display: none !important;">
                    <hr class="my-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-bold small">Subtotal:</span>
                        <span class="fw-bold" style="color: #1A1A2E; font-size: 16px;" id="cart-subtotal">RD$0.00</span>
                    </div>

                    <button type="button" 
                            class="btn-pink-primary w-100 py-2" 
                            style="font-size: 14px; font-weight: 600;"
                            onclick="irAlCheckout()">
                        Continuar al Checkout →
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const comercioId = "{{comercio._id}}";
    let carrito = [];

    function agregarAlPedido(id, nombre, precio, foto) {
        if (carrito.some(item => item.id === id)) {
            return; // mximo 1 unidad por producto segn requerimientos
        }

        carrito.push({ id, nombre, precio, foto });
        actualizarVistaCarrito();
    }

    function removerDelPedido(id) {
        carrito = carrito.filter(item => item.id !== id);
        actualizarVistaCarrito();
    }

    function actualizarVistaCarrito() {
        const cartEmpty = document.getElementById("cart-empty");
        const cartItems = document.getElementById("cart-items");
        const cartSummary = document.getElementById("cart-summary");
        const cartCount = document.getElementById("cart-count");
        const cartSubtotal = document.getElementById("cart-subtotal");

        cartCount.textContent = `${carrito.length} item${carrito.length === 1 ? '' : 's'}`;

        if (carrito.length === 0) {
            cartEmpty.style.setProperty("display", "block", "important");
            cartItems.style.setProperty("display", "none", "important");
            cartSummary.style.setProperty("display", "none", "important");
        } else {
            cartEmpty.style.setProperty("display", "none", "important");
            cartItems.style.setProperty("display", "flex", "important");
            cartSummary.style.setProperty("display", "block", "important");

            cartItems.innerHTML = "";
            let subtotal = 0;

            carrito.forEach(item => {
                subtotal += item.precio;
                const itemDiv = document.createElement("div");
                itemDiv.className = "d-flex justify-content-between align-items-center p-2 rounded-3 bg-light";
                itemDiv.innerHTML = `
                    <div style="max-width: 65%;">
                        <div class="fw-bold small text-truncate" style="color: #1a1a2e;">${item.nombre}</div>
                        <div class="text-muted small">RD$ ${Number(item.precio).toFixed(2)}</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="border-radius: 6px; font-size: 12px;" onclick="removerDelPedido('${item.id}')">
                        Eliminar
                    </button>
                `;
                cartItems.appendChild(itemDiv);
            });

            cartSubtotal.textContent = `RD$ ${subtotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        // Actualizar botones en el catálogo (deshabilitar o esconder segn seleccin)
        document.querySelectorAll(".btn-add-cart").forEach(btn => {
            const btnId = btn.id.replace("btn-add-", "");
            if (carrito.some(item => item.id === btnId)) {
                btn.disabled = true;
                btn.classList.replace("text-white", "text-muted");
                btn.style.background = "#e9ecef";
                btn.textContent = "? Agregado";
            } else {
                btn.disabled = false;
                btn.classList.replace("text-muted", "text-white");
                btn.style.background = "linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91))";
                btn.textContent = "+ Agregar";
            }
        });
    }

    function irAlCheckout() {
        if (carrito.length === 0) return;
        const itemIds = carrito.map(item => item.id).join(",");
        window.location.href = `/cliente/checkout/${comercioId}?items=${itemIds}`;
    }
</script>
