<section class="container" style="max-width: 1100px; margin-top: 90px; margin-bottom: 60px;">
    <!-- Encabezado del Comercio -->
    <div class="d-flex align-items-center mb-4">
        <a href="/cliente/home/comercios/{{comercio.tipoComercioId}}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 me-3">
            &larr; Volver
        </a>
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 56px; height: 56px; border: 1px solid #eee;">
                {{#if comercio.logoComercio}}
                    <img src="{{comercio.logoComercio}}" alt="{{comercio.nombreComercio}}" style="width: 48px; height: 48px; object-fit: cover; border-radius: 50%;">
                {{else}}
                    <span style="font-size: 28px;">??</span>
                {{/if}}
            </div>
            <div>
                <h3 class="fw-bold mb-0" style="color: #1a1a2e;">{{comercio.nombreComercio}}</h3>
                <small class="text-muted">Selecciona los productos para tu pedido  ? {{comercio.horaApertura}} - {{comercio.horaCierre}}</small>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- catálogo de Productos Agrupados -->
        <div class="col-lg-8">
            {{#each categorias}}
                <div class="mb-4">
                    <h4 class="fw-bold pb-2 border-bottom" style="color: #1a1a2e;">{{this.nombre}}</h4>
                    {{#if this.descripcion}}
                        <p class="text-muted small mb-3">{{this.descripcion}}</p>
                    {{/if}}

                    <div class="d-flex flex-column gap-3">
                        {{#each this.productos}}
                            <div class="card border-0 shadow-sm p-3 rounded-4 product-card" id="card-prod-{{this._id}}">
                                <div class="d-flex justify-content-between align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 70px; height: 70px; flex-shrink: 0; overflow: hidden;">
                                            {{#if this.foto}}
                                                <img src="{{this.foto}}" alt="{{this.nombre}}" style="width: 100%; height: 100%; object-fit: cover;">
                                            {{else}}
                                                <span style="font-size: 32px;">??</span>
                                            {{/if}}
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1 text-dark">{{this.nombre}}</h6>
                                            <p class="text-muted small mb-1">{{this.descripcion}}</p>
                                            <span class="fw-bold" style="color: #E91E63; font-size: 15px;">RD$ {{money this.precio}}</span>
                                        </div>
                                    </div>
                                    <div>
                                        <button type="button" 
                                                class="btn btn-add-cart px-3 py-2 text-white" 
                                                id="btn-add-{{this._id}}"
                                                style="background: linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91)); border-radius: 10px; font-weight: 600; font-size: 13px;"
                                                onclick="agregarAlPedido('{{this._id}}', '{{this.nombre}}', {{this.precio}}, '{{this.foto}}')">
                                            + Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{else}}
                <div class="card border-0 shadow-sm p-5 text-center rounded-4">
                    <p class="text-muted mb-0">Este comercio an no tiene productos disponibles.</p>
                </div>
            {{/each}}
        </div>

        <!-- Panel Lateral "Mi Pedido" -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 sticky-top" style="top: 90px;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0" style="color: #1a1a2e;">?? Mi pedido</h5>
                    <span class="badge bg-light text-dark" id="cart-count">0 items</span>
                </div>

                <!-- Empty State -->
                <div id="cart-empty" class="text-center py-5">
                    <div style="font-size: 48px; opacity: 0.4;">??</div>
                    <p class="text-muted mt-2 mb-0" style="font-size: 14px;">Tu pedido está vacíoo</p>
                    <small class="text-muted">Agrega productos del menú para continuar</small>
                </div>

                <!-- Cart Items Container -->
                <div id="cart-items" class="d-flex flex-column gap-2 mb-3" style="display: none !important;">
                </div>

                <!-- Resumen Subtotal y Botún Continuar -->
                <div id="cart-summary" style="display: none !important;">
                    <hr class="my-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-bold">Subtotal:</span>
                        <span class="fw-bold fs-5" style="color: #1a1a2e;" id="cart-subtotal">RD$ 0.00</span>
                    </div>

                    <button type="button" 
                            class="btn text-white w-100 py-3" 
                            style="background: linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91)); border-radius: 12px; font-weight: bold; font-size: 15px;"
                            onclick="irAlCheckout()">
                        Continuar ?
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const comercioId = "{{comercio._id}}";
    let carrito = [];

    function agregarAlPedido(id, nombre, precio, foto) {
        if (carrito.some(item => item.id === id)) {
            return; // mximo 1 unidad por producto segn requerimientos
        }

        carrito.push({ id, nombre, precio, foto });
        actualizarVistaCarrito();
    }

    function removerDelPedido(id) {
        carrito = carrito.filter(item => item.id !== id);
        actualizarVistaCarrito();
    }

    function actualizarVistaCarrito() {
        const cartEmpty = document.getElementById("cart-empty");
        const cartItems = document.getElementById("cart-items");
        const cartSummary = document.getElementById("cart-summary");
        const cartCount = document.getElementById("cart-count");
        const cartSubtotal = document.getElementById("cart-subtotal");

        cartCount.textContent = `${carrito.length} item${carrito.length === 1 ? '' : 's'}`;

        if (carrito.length === 0) {
            cartEmpty.style.setProperty("display", "block", "important");
            cartItems.style.setProperty("display", "none", "important");
            cartSummary.style.setProperty("display", "none", "important");
        } else {
            cartEmpty.style.setProperty("display", "none", "important");
            cartItems.style.setProperty("display", "flex", "important");
            cartSummary.style.setProperty("display", "block", "important");

            cartItems.innerHTML = "";
            let subtotal = 0;

            carrito.forEach(item => {
                subtotal += item.precio;
                const itemDiv = document.createElement("div");
                itemDiv.className = "d-flex justify-content-between align-items-center p-2 rounded-3 bg-light";
                itemDiv.innerHTML = `
                    <div style="max-width: 65%;">
                        <div class="fw-bold small text-truncate" style="color: #1a1a2e;">${item.nombre}</div>
                        <div class="text-muted small">RD$ ${Number(item.precio).toFixed(2)}</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="border-radius: 6px; font-size: 12px;" onclick="removerDelPedido('${item.id}')">
                        Eliminar
                    </button>
                `;
                cartItems.appendChild(itemDiv);
            });

            cartSubtotal.textContent = `RD$ ${subtotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        // Actualizar botones en el catálogo (deshabilitar o esconder segn seleccin)
        document.querySelectorAll(".btn-add-cart").forEach(btn => {
            const btnId = btn.id.replace("btn-add-", "");
            if (carrito.some(item => item.id === btnId)) {
                btn.disabled = true;
                btn.classList.replace("text-white", "text-muted");
                btn.style.background = "#e9ecef";
                btn.textContent = "? Agregado";
            } else {
                btn.disabled = false;
                btn.classList.replace("text-muted", "text-white");
                btn.style.background = "linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91))";
                btn.textContent = "+ Agregar";
            }
        });
    }

    function irAlCheckout() {
        if (carrito.length === 0) return;
        const itemIds = carrito.map(item => item.id).join(",");
        window.location.href = `/cliente/checkout/${comercioId}?items=${itemIds}`;
    }
</script>
