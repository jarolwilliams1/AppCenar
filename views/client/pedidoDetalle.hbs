<div class="app-container" style="max-width: 680px;">
    <div class="mb-3">
        <a href="/cliente/pedidos" class="back-link">
            ← Volver a mis pedidos
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <!-- Cabecera del pedido -->
        <div class="d-flex justify-content-between align-items-start pb-3 mb-3 border-bottom flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 48px; height: 48px; font-size: 14px;">
                    {{#if pedido.comercioId.logoComercio}}
                        <img src="{{pedido.comercioId.logoComercio}}" alt="Logo" style="width: 40px; height: 40px; object-fit: cover; border-radius: 8px;">
                    {{else}}
                        <div class="logo-square" style="width: 36px; height: 36px; font-size: 13px; margin: 0;">AC</div>
                    {{/if}}
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark" style="font-size: 16px;">{{pedido.comercioId.nombreComercio}}</h5>
                    <small class="text-muted" style="font-size: 12.5px;">Pedido #{{pedido._id}} · {{formatDate pedido.createdAt}}</small>
                </div>
            </div>

            <span class="badge {{statusBadge pedido.estado}} rounded-pill px-3 py-1" style="font-size: 11.5px;">
                {{statusLabel pedido.estado}}
            </span>
        </div>

        <!-- Lista de Productos -->
        <div class="mb-4">
            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">PRODUCTOS</div>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-1 ps-2">
                {{#each pedido.productos}}
                    <li class="d-flex align-items-center gap-2" style="font-size: 13.5px; color: #374151;">
                        <span>•</span>
                        <span>{{this.nombre}}</span>
                    </li>
                {{/each}}
            </ul>
        </div>

        <!-- Dirección de entrega y Total -->
        <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 13px;">
                <svg width="14" height="14" fill="#E91E63" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span class="text-dark fw-semibold">{{pedido.direccion.nombre}}</span> - <span>{{pedido.direccion.descripcion}}</span>
            </div>

            <div class="fw-bold" style="color: #E91E63; font-size: 18px;">
                RD${{money pedido.total}}
            </div>
        </div>
    </div>
</div>
