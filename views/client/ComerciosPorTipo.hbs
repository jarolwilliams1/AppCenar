<section class="container" style="max-width: 900px; margin-top: 90px; margin-bottom: 50px;">
    <div class="d-flex align-items-center mb-3">
        <a href="/cliente/home" class="btn btn-outline-secondary btn-sm rounded-pill px-3 me-3">
            &larr; Volver
        </a>
        <div>
            <h2 class="fw-bold mb-0" style="color: #1a1a2e;">{{tipo.nombre}}</h2>
            <small class="text-muted">{{totalComercios}} comercios disponibles</small>
        </div>
    </div>

    <!-- Buscador -->
    <form action="/cliente/home/comercios/{{tipo._id}}" method="GET" class="mb-4">
        <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden;">
            <input type="text" name="q" class="form-control border-0 py-2 px-3" placeholder="Buscar por nombre del comercio..." value="{{searchQuery}}">
            <button class="btn text-white px-4" type="submit" style="background-color: #E91E63;">
                ??
            </button>
        </div>
    </form>

    <!-- Listado de Comercios -->
    <div class="d-flex flex-column gap-3">
        {{#each comercios}}
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 64px; height: 64px; border: 1px solid #eee;">
                            {{#if this.logoComercio}}
                                <img src="{{this.logoComercio}}" alt="{{this.nombreComercio}}" style="width: 54px; height: 54px; object-fit: cover; border-radius: 8px;">
                            {{else}}
                                <span style="font-size: 32px;">??</span>
                            {{/if}}
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0 text-dark">{{this.nombreComercio}}</h5>
                                <form action="/cliente/favoritos/toggle/{{this._id}}" method="POST" class="d-inline m-0">
                                    <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Favorito" style="font-size: 18px;">
                                        {{#if this.esFavorito}}??{{else}}??{{/if}}
                                    </button>
                                </form>
                            </div>
                            <small class="text-muted d-block">? {{this.horaApertura}} - {{this.horaCierre}}  ?? {{this.telefono}}</small>
                        </div>
                    </div>

                    <div>
                        <a href="/cliente/comercio/{{this._id}}" class="btn text-white px-4 py-2" style="background: linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91)); border-radius: 10px; font-weight: 600; font-size: 14px;">
                            Ver menú
                        </a>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="card border-0 shadow-sm p-5 text-center rounded-4">
                <p class="text-muted mb-0">No se encontraron comercios registrados en esta categoría.</p>
                {{#if searchQuery}}
                    <div class="mt-3">
                        <a href="/cliente/home/comercios/{{tipo._id}}" class="btn btn-sm btn-outline-secondary">Limpiar búsqueda</a>
                    </div>
                {{/if}}
            </div>
        {{/each}}
    </div>
</section>
