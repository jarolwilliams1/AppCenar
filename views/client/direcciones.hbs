<div class="app-container" style="max-width: 780px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Mis Direcciones</h3>
            <p class="text-muted small mb-0">Gestiona tus direcciones de entrega</p>
        </div>
        <button type="button" class="btn-pink-primary" onclick="toggleFormDireccion()">
            + Dirección
        </button>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Formulario Inline / Colapsable de Nueva / Editar Dirección -->
    <div id="formDireccionCard" class="card border-0 shadow-sm p-4 rounded-4 mb-4" 
         style="background: #FFFFFF; border: 1px solid #EEF2F6; {{#unless mostrarForm}}display: none;{{/unless}}">
        <h5 class="fw-bold text-dark mb-3" style="font-size: 15px;" id="formTitle">
            {{#if modoEdicion}}Editar dirección{{else}}Nueva dirección{{/if}}
        </h5>
        <form id="formDirAction" action="{{#if modoEdicion}}/cliente/direcciones/{{direccionEdit._id}}/editar{{else}}/cliente/direcciones{{/if}}" method="POST">
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-5">
                    <label class="form-label text-muted small fw-semibold">Nombre (ej. Casa, Oficina)</label>
                    <input type="text" class="form-control" name="nombre" id="inputNombreDir" value="{{#if direccionEdit}}{{direccionEdit.nombre}}{{/if}}" placeholder="Casa" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-7">
                    <label class="form-label text-muted small fw-semibold">Descripción completa</label>
                    <input type="text" class="form-control" name="descripcion" id="inputDescDir" value="{{#if direccionEdit}}{{direccionEdit.descripcion}}{{/if}}" placeholder="Calle Duarte #45, Santiago" required style="font-size: 13.5px;">
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-pink-primary">Guardar</button>
                <button type="button" class="btn-cancel-custom" onclick="cancelarFormDireccion()">Cancelar</button>
            </div>
        </form>
    </div>

    <!-- Listado de Direcciones -->
    <div class="d-flex flex-column gap-3">
        {{#each direcciones}}
            <div class="card border-0 shadow-sm p-3 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div style="font-size: 24px;">
                            📍
                        </div>
                        <div>
                            <div class="fw-bold text-dark mb-0" style="font-size: 14.5px;">{{this.nombre}}</div>
                            <small class="text-muted" style="font-size: 12.5px;">{{this.descripcion}}</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn-outline-custom" onclick="editarDireccion('{{this._id}}', '{{this.nombre}}', '{{this.descripcion}}')">
                            Editar
                        </button>
                        <form action="/cliente/direcciones/{{this._id}}/eliminar" method="POST" class="m-0" onsubmit="return confirm('¿Eliminar esta dirección?');">
                            <button type="submit" class="btn-danger-pill">
                                Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="card border-0 shadow-sm p-5 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <div style="font-size: 36px;" class="mb-2">📍</div>
                <p class="text-muted mb-3">No tienes direcciones registradas todavía.</p>
                <div>
                    <button type="button" class="btn-pink-primary" onclick="toggleFormDireccion()">
                        + Agregar Dirección
                    </button>
                </div>
            </div>
        {{/each}}
    </div>
</div>

<script>
    function toggleFormDireccion() {
        const card = document.getElementById('formDireccionCard');
        document.getElementById('formTitle').innerText = 'Nueva dirección';
        document.getElementById('formDirAction').action = '/cliente/direcciones';
        document.getElementById('inputNombreDir').value = '';
        document.getElementById('inputDescDir').value = '';
        card.style.display = card.style.display === 'none' ? 'block' : 'none';
        if (card.style.display === 'block') {
            document.getElementById('inputNombreDir').focus();
        }
    }

    function editarDireccion(id, nombre, desc) {
        const card = document.getElementById('formDireccionCard');
        document.getElementById('formTitle').innerText = 'Editar dirección';
        document.getElementById('formDirAction').action = '/cliente/direcciones/' + id + '/editar';
        document.getElementById('inputNombreDir').value = nombre;
        document.getElementById('inputDescDir').value = desc;
        card.style.display = 'block';
        card.scrollIntoView({ behavior: 'smooth' });
    }

    function cancelarFormDireccion() {
        document.getElementById('formDireccionCard').style.display = 'none';
    }
</script>
