<div class="app-container">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Mis Pedidos</h3>
        <p class="text-muted small mb-0">Historial completo de tus pedidos</p>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <div class="d-flex flex-column gap-3">
        {{#each pedidos}}
            <a href="/cliente/pedidos/{{this._id}}" class="text-decoration-none text-dark">
                <div class="card border-0 shadow-sm p-3 rounded-4" 
                     style="background: #FFFFFF; border: 1px solid #EEF2F6; transition: transform 0.15s ease, box-shadow 0.15s ease;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 48px; height: 48px; font-size: 24px;">
                                {{#if this.comercioId.logoComercio}}
                                    <img src="{{this.comercioId.logoComercio}}" alt="Logo" style="width: 40px; height: 40px; object-fit: cover; border-radius: 8px;">
                                {{else}}
                                    🍕
                                {{/if}}
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark" style="font-size: 15px;">{{this.comercioId.nombreComercio}}</h6>
                                <small class="text-muted" style="font-size: 12px;">{{formatDate this.createdAt}} · {{this.productos.length}} productos</small>
                            </div>
                        </div>

                        <div class="text-end">
                            <div class="fw-bold mb-1" style="color: #E91E63; font-size: 15px;">RD${{money this.total}}</div>
                            <span class="badge {{statusBadge this.estado}} rounded-pill px-3 py-1" style="font-size: 11px;">
                                {{statusLabel this.estado}}
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        {{else}}
            <div class="card border-0 shadow-sm p-5 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <p class="text-muted mb-3">Aún no has realizado ningún pedido.</p>
                <div>
                    <a href="/cliente/home" class="btn-pink-primary">
                        Explorar Comercios
                    </a>
                </div>
            </div>
        {{/each}}
    </div>
</div>
