<section class="clienteDelivery-seccion">
    <a href="/login" class="volver">&larr; Volver al inicio de sesión</a>

    <section class="card">
        <h2 class="text-head">Crear cuenta</h2>
        <p class="text">Regístrate como cliente o delivery</p>

        <form action="/registrar" method="POST" enctype="multipart/form-data" class="registro-form">
            {{#if error}}
                <div class="advertencia-login" id="AdvertenciaLogin">
                    {{error}}
                </div>
            {{/if}}

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="nombrelCDInput" class="form-label">Nombre *</label>
                    <input type="text" class="form-control" id="nombrelCDInput" name="nombrelCDInput" value="{{datos.nombrelCDInput}}" placeholder="ej. Carlos" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="apellidolCDInput" class="form-label">Apellido *</label>
                    <input type="text" class="form-control" id="apellidolCDInput" name="apellidolCDInput" value="{{datos.apellidolCDInput}}" placeholder="ej. Pérez" required>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="telefonoCDInput" class="form-label">Teléfono *</label>
                    <input type="text" class="form-control" id="telefonoCDInput" name="telefonoCDInput" value="{{datos.telefonoCDInput}}" placeholder="+1 809-000-0000" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="emailCDInput" class="form-label">Correo electrónico *</label>
                    <input type="email" class="form-control" id="emailCDInput" name="emailCDInput" value="{{datos.emailCDInput}}" placeholder="name@example.com" required>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="usuarioCDInput" class="form-label">Nombre de usuario *</label>
                    <input type="text" class="form-control" id="usuarioCDInput" name="usuarioCDInput" value="{{datos.usuarioCDInput}}" placeholder="ej. carlos_p" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="rolCDInput" class="form-label">Rol *</label>
                    <select class="form-select" id="rolCDInput" name="rolCDInput" required>
                        <option value="Cliente" {{seleccionado datos.rolCDInput "Cliente"}}>Cliente</option>
                        <option value="Delivery" {{seleccionado datos.rolCDInput "Delivery"}}>Delivery</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label for="fotoCDInput" class="form-label">Foto de perfil (opcional)</label>
                <input type="file" class="form-control" id="fotoCDInput" name="fotoCDInput" accept="image/*">
            </div>

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="passwordCDInput" class="form-label">Contraseña *</label>
                    <input type="password" class="form-control" id="passwordCDInput" name="passwordCDInput" placeholder="••••••••" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="confirmarPasswordCDInput" class="form-label">Confirmar contraseña *</label>
                    <input type="password" class="form-control" id="confirmarPasswordCDInput" name="confirmarPasswordCDInput" placeholder="••••••••" required>
                </div>
            </div>

            <button class="btn-primary2" type="submit">Crear cuenta</button>
        </form>
    </section>
</section>
