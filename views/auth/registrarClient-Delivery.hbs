<section class="clienteDelivery-seccion">
    
<a href="" class="volver">← Volver al inicio de sesión</a>

<section class="card">
    <h2 class="text-head">Crear cuenta</h2>
    <p class="text">Regístrate como Cliente o Delivery</p>

    <div class="container ">

    <form action="" method="post">
            <div class="row">
            <div class="mb-3 col-sm-12 col-md-6">
            <label for="nombrelCDInput" class="form-label">Nombre *</label>
            <input type="text" class="form-control" id="nombrelCDInput" name="nombrelCDInput" placeholder="ej. Jarol" required>
            </div>

            <div class="mb-3 col-sm-12 col-md-6 ">
            <label for="apellidolCDInput" class="form-label">Apellido</label>
            <input type="text" class="form-control" id="apellidolCDInput" name="apellidolCDInput" placeholder="ej. Williams">
            </div>
        </div>


        
        <div class="row">
            <div class="mb-3 col-sm-12 col-md-6">
            <label for="telefonoCDInput" class="form-label">Teléfono *</label>
            <input type="text" class="form-control" id="telefonoCDInput" name="telefonoCDInput" placeholder="+1 809-000-0000" required>
            </div>

            <div class="mb-3 col-sm-12 col-md-6 ">
            <label for="emailCDInput" class="form-label">Correo electrónico *</label>
            <input type="email" class="form-control" id="emailCDInput" name="emailCDInput" placeholder="name@example.com" required>
            </div>
        </div>




        
        <div class="row">
            <div class="mb-3 col-sm-12 col-md-6">
            <label for="usuarioCDInput" class="form-label">Nombre de usuario *</label>
            <input type="text" class="form-control" id="usuarioCDInput" name="usuarioCDInput" placeholder="ej. jarol_w" required>
            </div>

            <div class="mb-3 col-sm-12 col-md-6 ">
            <label for="exampleFormControlInput1" class="form-label">Rol</label>
            <select class="form-select" aria-label="Default select example" required>
            <option value="Cliente">Cliente</option>
            <option value="Delivery">Delivery</option>
            </select>
            </div>
        </div>

            <div class="mb-3 ">
            <label for="fotoCDInput" class="form-label">Foto de perfil</label>
            <input type="file" class="form-control" id="fotoCDInput" name="fotoCDInput" required>
            </div>

        
        <div class="row">
            <div class="mb-3 col-sm-12 col-md-6">
            <label for="passwordCDInput" class="form-label">Contraseña *</label>
            <input type="password" class="form-control" id="passwordCDInput" name="passwordCDInput" placeholder="........" required>
            </div>

            <div class="mb-3 col-sm-12 col-md-6 ">
            <label for="confirmarPasswordCDInput" class="form-label">Confirmar contraseña *</label>
            <input type="password" class="form-control" id="confirmarPasswordCDInput" name="confirmarPasswordCDInput"placeholder="........" required>
            </div>
        </div>


    </div>
    
<button class=" btn-primary2" type="submit" value="Submit">Crear cuenta</button>
    </form>
</section>
</section>