<section class="login-seccion">
    <div class="encabezado">
        <div class="logo-encaezado">
            <span>AC</span>
        </div>
        <h2 class="nameApp">AppCenar</h2>
        <p class="text-head">recuperación de contraseña</p>
    </div>

    <form action="/recuperar-password" method="post" class="login-form">
        <div class="login-card">
            <h2 class="card-text">Restablecer contraseña</h2>
            <p class="text-muted mb-3" style="font-size: 13px;">Ingresa tu correo electrónico o nombre de usuario registrado para recibir el enlace de recuperación.</p>

            {{#if success}}
                <div class="alert alert-success py-2" style="font-size: 14px; border-radius: 8px;">
                    {{success}}
                </div>
            {{/if}}

            {{#if error}}
                <div class="advertencia-login" id="AdvertenciaLogin">
                    {{error}}
                </div>
            {{/if}}

            <div class="mb-3">
                <label for="identificador" class="form-label">Usuario o Correo *</label>
                <input type="text" class="form-control" id="identificador" placeholder="ej. cliente@appcenar.com" name="identificador" required>
            </div>

            <button class="btn-primary2" type="submit">Enviar Enlace</button>

            <div class="linea"></div>

            <a href="/login" class="btn btn-outline-secondary w-100 py-2" style="border-radius: 8px; font-weight: 600; font-size: 13px;">
                &larr; Volver al inicio de sesión
            </a>
        </div>
    </form>
</section>
