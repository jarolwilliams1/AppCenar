<section class="clienteDelivery-seccion">
    <a href="/login" class="volver">&larr; Volver al inicio de sesión</a>

    <section class="card">
        <h2 class="text-head">Registrar Comercio</h2>
        <p class="text">Completa los datos de tu negocio</p>

        <form action="/registrarComercio" method="post" enctype="multipart/form-data" class="registro-form">
            {{#if error}}
                <div class="advertencia-login" id="AdvertenciaLogin">
                    {{error}}
                </div>
            {{/if}}

            <div class="mb-3">
                <label for="comercioInputNombre" class="form-label">Nombre del comercio *</label>
                <input type="text" class="form-control" id="comercioInputNombre" name="comercioInputNombre" value="{{datos.comercioInputNombre}}" placeholder="ej. Pizzeria Bella" required>
            </div>

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="comercioInputTelefono" class="form-label">Teléfono *</label>
                    <input type="text" class="form-control" id="comercioInputTelefono" name="comercioInputTelefono" value="{{datos.comercioInputTelefono}}" placeholder="+1 809-000-0000" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="comercioInputEmail" class="form-label">Correo *</label>
                    <input type="email" class="form-control" id="comercioInputEmail" name="comercioInputEmail" value="{{datos.comercioInputEmail}}" placeholder="name@example.com" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="comercioInputLogo" class="form-label">Logo del comercio (opcional)</label>
                <input type="file" class="form-control" id="comercioInputLogo" name="comercioInputLogo" accept="image/*">
            </div>

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-4">
                    <label for="comercioInputAperturaH" class="form-label">Hora de apertura *</label>
                    <input type="time" class="form-control" id="comercioInputAperturaH" name="comercioInputAperturaH" value="{{datos.comercioInputAperturaH}}" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-4">
                    <label for="comercioInputCierreH" class="form-label">Hora de cierre *</label>
                    <input type="time" class="form-control" id="comercioInputCierreH" name="comercioInputCierreH" value="{{datos.comercioInputCierreH}}" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-4">
                    <label for="comercioSelectTipo" class="form-label">Tipo de comercio *</label>
                    <select class="form-select" id="comercioSelectTipo" name="comercioSelectTipo" required>
                        <option value="">Seleccione un tipo</option>
                        {{#each listaTiposComercio}}
                            <option value="{{this._id}}">{{this.nombre}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="comercioPasswordInput" class="form-label">Contraseña *</label>
                    <input type="password" class="form-control" id="comercioPasswordInput" name="comercioPasswordInput" placeholder="••••••••" required>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label for="confirmarComercioPasswordInput" class="form-label">Confirmar contraseña *</label>
                    <input type="password" class="form-control" id="confirmarComercioPasswordInput" name="confirmarComercioPasswordInput" placeholder="••••••••" required>
                </div>
            </div>

            <button class="btn-primary2" type="submit">Registrar Comercio</button>
        </form>
    </section>
</section>
