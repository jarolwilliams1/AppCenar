<section class="clienteDelivery-seccion">
    
<a href="" class="volver"  onclick="location.href='/login'">← Volver al inicio de sesión</a>

<section class="card">
    <h2 class="text-head">Registrar Comercio</h2>
    <p class="text">Completa los datos de tu negocio</p>

    <div class="container ">

    <form action="/registrarComercio" method="post">
   {{#if error}}
  <div class="advertencia-login" id="AdvertenciaLogin">
    {{error}}
  </div>
{{/if}}

             <div class="mb-3">
            <label for="comercioInputNombre" class="form-label">Nombre del comercio *</label>
            <input type="text" class="form-control" id="comercioInputNombre" name="comercioInputNombre" placeholder="ej. Pizzeria Bella" >
            </div>


        
        <div class="row">
            <div class="mb-3 col-sm-12 col-md-6">
            <label for="comercioInputTelefono" class="form-label">Teléfono *</label>
            <input type="text" class="form-control" id="comercioInputTelefono" name="comercioInputTelefono" placeholder="+1 809-000-0000" >
            </div>

            <div class="mb-3 col-sm-12 col-md-6 ">
            <label for="comercioInputEmail" class="form-label">Correo *</label>
            <input type="email" class="form-control" id="comercioInputEmail" name="comercioInputEmail" placeholder="name@example.com" >
            </div>
        </div>



  <div class="mb-3 ">
            <label for="comercioInputLogo" class="form-label">Logo del comercio</label>
            <input type="file" class="form-control" id="comercioInputLogo" name="comercioInputLogo" >
            </div>
        
        <div class="row">
            <div class="mb-3 col-sm-12 col-md-4">
            <label for="comercioInputAperturaH" class="form-label">Hora apertura *</label>
            <input type="time" class="form-control" id="comercioInputAperturaH" name="comercioInputAperturaH"  >
            </div>

              <div class="mb-3 col-sm-12 col-md-4">
            <label for="comercioInputCierreH" class="form-label">Hora cierre *</label>
            <input type="time" class="form-control" id="comercioInputCierreH" name="comercioInputCierreH"  >
            </div>

            <div class="mb-3 col-sm-12 col-md-4 ">
            <label for="comercioSelectTipo" class="form-label">Tipo de comercio</label>
            <select class="form-select" aria-label="Default select example" id="comercioSelectTipo" name="comercioSelectTipo" >
            <option value="Restaurante">Restaurante</option>
            <option value="Mercado">Mercado</option>
            <option value="Bebidas">Bebidas</option>
            <option value="Farmacia">Farmacia</option>
            <option value="Cafeteria">Cafeteria</option>
            </select>
            </div>
        </div>

          

        
        <div class="row">
            <div class="mb-3 col-sm-12 col-md-6">
            <label for="passwordCDInput" class="form-label">Contraseña *</label>
            <input type="password" class="form-control" id="comercioPasswordInput" name="comercioPasswordInput" placeholder="........" >
            </div>

            <div class="mb-3 col-sm-12 col-md-6 ">
            <label for="confirmarPasswordCDInput" class="form-label">Confirmar contraseña *</label>
            <input type="password" class="form-control" id="confirmarComercioPasswordInput" name="confirmarComercioPasswordInput"placeholder="........" >
            </div>
        </div>


    </div>
    
<button class=" btn-primary2" type="submit" value="Submit">Registrar Comercio</button>
    </form>
</section>
</section>