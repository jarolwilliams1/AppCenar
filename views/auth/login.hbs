<section class="login-seccion">
    
    <div class="encabezado">
        <div class="logo-encaezado">
            <img src="" alt="" class="logo">
        </div>

          <h2 class="nameApp">AppCenar</h2>
    <p class="text-head">Tu comida favorita, a un clic</p>

    </div>
  
 <form action="/login" method="post">
     <div class="login-card">
    <h2 class="card-text">Iniciar Sesión</h2>

{{#if error}}
  <div class="advertencia-login" id="AdvertenciaLogin">
    {{error}}
  </div>
{{/if}}
  <div class="mb-3">
  <label for="exampleFormControlInput1" class="form-label">Usuario</label>
  <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="ej.cliente" name="usuario" required>
</div>


<div class="mb-3">
  <label for="exampleFormControlInput1" class="form-label">Contraseña</label>
  <input type="password" class="form-control" id="exampleFormControlInput1" placeholder="........" name="password" required>
</div>

<button class=" btn-primary2" type="submit" value="Submit">Iniciar Sesión</button>

<div class="linea"></div>

<button type="button" class="btn-registrar-cliente-delivery"  onclick="location.href='/registrar'">Registrarse como Cliente o Delivery</button>

<button type="button" class="btn-registrar-comercio"  onclick="location.href='/RegistrarComercio'">Registrarse como Comercio</button>

<button type="button" class="btn-olvide-contra"  onclick="location.href='/'">Olvidé mi contraseña</button>



  </div>
 </form>

</section>