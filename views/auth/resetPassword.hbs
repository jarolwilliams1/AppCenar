<section class="login-seccion">
    <div class="encabezado">
        <div class="logo-encaezado">
            <span>AC</span>
        </div>
        <h2 class="nameApp">AppCenar</h2>
        <p class="text-head">Nueva contraseña</p>
    </div>

    <form action="/reset-password" method="post" class="login-form">
        <div class="login-card">
            <h2 class="card-text">Establecer Nueva contraseña</h2>

            {{#if error}}
                <div class="advertencia-login" id="AdvertenciaLogin">
                    {{error}}
                </div>
            {{/if}}

            {{#if invalido}}
                <p class="text-muted mb-4">El enlace es inválido o ha expirado.</p>
                <a href="/recuperar-password" class="btn-primary2 text-decoration-none d-block">Solicitar nuevo enlace</a>
            {{else}}
                <input type="hidden" name="token" value="{{token}}">

                <div class="mb-3">
                    <label for="password" class="form-label">Nueva contraseña *</label>
                    <input type="password" class="form-control" id="password" placeholder="••••••••" name="password" required>
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Confirmar Nueva contraseña *</label>
                    <input type="password" class="form-control" id="confirmPassword" placeholder="••••••••" name="confirmPassword" required>
                </div>

                <button class="btn-primary2" type="submit">Guardar contraseña</button>
            {{/if}}

            <div class="linea"></div>

            <a href="/login" class="btn btn-outline-secondary w-100 py-2" style="border-radius: 8px; font-weight: 600; font-size: 13px;">
                &larr; Volver al inicio de sesión
            </a>
        </div>
    </form>
</section>
