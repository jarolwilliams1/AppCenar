<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>AppCenar | Panel Administrador</title>
</head>
<body>
    <nav class="navbar navbar-expand-xl app-navbar fixed-top">
        <div class="container-fluid px-3 px-lg-4">
            <a href="/admin/dashboard" class="brand-logo">
                <div class="logo-square">AC</div>
                <div class="brand-text">App<span>Cenar</span></div>
            </a>

            <button class="navbar-toggler border-0 shadow-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#appNavbarCollapse" aria-controls="appNavbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="appNavbarCollapse">
                <ul class="navbar-nav mx-auto nav-center-menu">
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'dashboard')}}active{{/if}}" href="/admin/dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'clientes')}}active{{/if}}" href="/admin/clientes">Clientes</a></li>
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'deliveries')}}active{{/if}}" href="/admin/deliveries">Deliveries</a></li>
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'comercios')}}active{{/if}}" href="/admin/comercios">Comercios</a></li>
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'configuracion')}}active{{/if}}" href="/admin/configuracion">Configuración</a></li>
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'administradores')}}active{{/if}}" href="/admin/administradores">Administradores</a></li>
                    <li class="nav-item"><a class="nav-link-custom {{#if (eq activeTab 'tipos')}}active{{/if}}" href="/admin/tipo-comercio">Tipos de Comercio</a></li>
                </ul>

                <div class="nav-user-area">
                    <div class="user-info-block">
                        <div class="user-name">{{#if sessionUser.nombre}}{{sessionUser.nombre}}{{else if sessionUser.usuario}}{{sessionUser.usuario}}{{else}}Admin{{/if}}</div>
                        <span class="role-badge role-badge-admin">ADMINISTRADOR</span>
                    </div>
                    <a href="/logout" class="btn-nav-logout">Salir</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="main-wrapper">
        {{{body}}}
    </main>

    {{> footer}}

    <script src="/js/bootstrap.bundle.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>
