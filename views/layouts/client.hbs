<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/cliente.css">
    <title>AppCenar | Cliente</title>
</head>
<body>
    <nav class="cliente-nav">
        <div class="izquierda">
            <a href="/cliente/home" class="d-flex align-items-center text-decoration-none">
                <div class="cuadrologo me-2">
                    <span class="text-white fw-bold">AC</span>
                </div>
                <h2 class="text-head mb-0">App<span class="partenegra">Cenar</span></h2>
            </a>
        </div>

        <div class="centro">
            <ul class="nav justify-content-center">
                <li class="nav-item">
                    <a class="nav-link" href="/cliente/home">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/cliente/pedidos">Mis Pedidos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/cliente/direcciones">Mis direcciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/cliente/favoritos">Mis Favoritos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/cliente/perfil">Mi Perfil</a>
                </li>
            </ul>
        </div>

        <div class="derecha">
            <div class="name-rol">
                <h3 class="nombre">{{#if sessionUser.nombre}}{{sessionUser.nombre}}{{else if sessionUser.usuario}}{{sessionUser.usuario}}{{else}}Cliente{{/if}}</h3>
                <h3 class="rol">CLIENTE</h3>
            </div>
            <a href="/logout" class="btn-salir text-decoration-none d-flex align-items-center">Salir</a>
        </div>
    </nav>

    <main>
        {{{body}}}
    </main>

    <script src="/js/bootstrap.bundle.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>
