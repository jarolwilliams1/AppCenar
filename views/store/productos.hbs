<div class="app-container-wide">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Productos</h3>
            <p class="text-muted small mb-0">Gestiona los productos de tu menú</p>
        </div>
        <button type="button" class="btn-pink-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoProducto">
            + Nuevo Producto
        </button>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Modal Crear Nuevo Producto -->
    <div class="modal fade" id="modalNuevoProducto" tabindex="-1" aria-labelledby="modalNuevoProductoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="modalNuevoProductoLabel">Nuevo Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/comercio/productos" method="POST" enctype="multipart/form-data">
                    <div class="modal-body py-3">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Nombre del producto</label>
                                <input type="text" class="form-control" name="NombreNuevoPorducto" placeholder="Pizza Margarita" required style="font-size: 13.5px;">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Categoría</label>
                                <select class="form-select" name="CategoriaNuevoProducto" required style="font-size: 13.5px;">
                                    <option value="">Selecciona una categoría</option>
                                    {{#each CategoriaLista}}
                                        <option value="{{this._id}}">{{this.nombre}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Precio (RD$)</label>
                                <input type="number" step="0.01" min="0" class="form-control" name="PrecioNuevoProducto" placeholder="550" required style="font-size: 13.5px;">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Foto del producto (opcional)</label>
                                <input type="file" class="form-control" name="FotoProductoNuevo" accept="image/*" style="font-size: 13.5px;">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-semibold">Descripción del producto</label>
                            <textarea class="form-control" rows="3" name="DescripcionNuevoProducto" placeholder="Salsa de tomate, mozzarella, albahaca" required style="font-size: 13.5px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn-cancel-custom" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-pink-primary">Crear Producto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tabla de Productos -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <div class="table-responsive">
            <table class="table table-app align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">FOTO</th>
                        <th>NOMBRE</th>
                        <th>DESCRIPCIÓN</th>
                        <th>CATEGORÍA</th>
                        <th>PRECIO</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productsList}}
                        <tr>
                            <td class="ps-4">
                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 44px; height: 44px; overflow: hidden; font-size: 13px;">
                                    {{#if this.foto}}
                                        <img src="{{this.foto}}" alt="{{this.nombre}}" style="width: 100%; height: 100%; object-fit: cover;">
                                    {{else}}
                                        <div class="logo-square" style="width: 36px; height: 36px; font-size: 13px; margin: 0;">AC</div>
                                    {{/if}}
                                </div>
                            </td>
                            <td class="fw-bold text-dark">{{this.nombre}}</td>
                            <td class="text-muted small">{{this.descripcion}}</td>
                            <td>
                                <span class="badge rounded-pill px-3 py-1 fw-semibold" style="background-color: #FCE4EC; color: #E91E63; font-size: 11.5px;">
                                    {{#if this.categoriaId.nombre}}{{this.categoriaId.nombre}}{{else}}General{{/if}}
                                </span>
                            </td>
                            <td class="fw-bold" style="color: #E91E63; font-size: 14.5px;">RD${{money this.precio}}</td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn-outline-custom me-1" data-bs-toggle="modal" data-bs-target="#modalEditarProd-{{this._id}}">
                                    Editar
                                </button>
                                <form action="/comercio/productos/{{this._id}}/eliminar" method="POST" class="d-inline m-0" onsubmit="return confirm('¿Eliminar este producto?');">
                                    <button type="submit" class="btn-danger-pill">
                                        Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>

                        <!-- Modal Editar Producto -->
                        <div class="modal fade" id="modalEditarProd-{{this._id}}" tabindex="-1" aria-labelledby="modalEditarProdLabel-{{this._id}}" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-dark" id="modalEditarProdLabel-{{this._id}}">Editar Producto</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form action="/comercio/productos/{{this._id}}/editar" method="POST" enctype="multipart/form-data">
                                        <div class="modal-body py-3 text-start">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold">Nombre del producto *</label>
                                                    <input type="text" class="form-control" name="nombre" value="{{this.nombre}}" required>
                                                </div>

                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold">Categoría *</label>
                                                    <select class="form-select" name="categoriaId" required>
                                                        <option value="">Selecciona una categoría</option>
                                                        {{#each ../CategoriaLista}}
                                                            <option value="{{this._id}}" {{#if (eq ../categoriaId._id this._id)}}selected{{/if}}>
                                                                {{this.nombre}}
                                                            </option>
                                                        {{/each}}
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold">Precio (RD$) *</label>
                                                    <input type="number" step="0.01" min="0" class="form-control" name="precio" value="{{this.precio}}" required>
                                                </div>

                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold">Cambiar Foto (opcional)</label>
                                                    <input type="file" class="form-control" name="foto" accept="image/*">
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Descripción del producto *</label>
                                                <textarea class="form-control" rows="3" name="descripcion" required>{{this.descripcion}}</textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Cancelar</button>
                                            <button type="submit" class="btn text-white px-4" style="background-color: #E91E63; border-radius: 8px; font-weight: 600;">Guardar Cambios</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Confirmación Eliminar Producto -->
                        <div class="modal fade" id="modalEliminarProd-{{this._id}}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-dark">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-muted py-3 text-start">
                                        ¿Estás seguro de que deseas eliminar el producto <strong>"{{this.nombre}}"</strong>?
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">Cancelar</button>
                                        <form action="/comercio/productos/{{this._id}}/eliminar" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-danger px-3" style="border-radius: 8px;">Aceptar y Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No tienes productos creados todavía. Haz clic en <strong>"+ Nuevo Producto"</strong> para agregar el primero.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>
