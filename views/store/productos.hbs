<section class="container" style="max-width: 1000px; margin-top: 90px; margin-bottom: 60px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1a1a2e;">Productos</h2>
            <p class="text-muted mb-0">Gestiona los productos de tu menú</p>
        </div>
        {{#unless mostrarForm}}
            <a href="/comercio/productosínuevo=1" class="btn text-white px-3 py-2" style="background: linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91)); border-radius: 10px; font-weight: 600; font-size: 13px;">
                + Nuevo Producto
            </a>
        {{/unless}}
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Formulario Crear / Editar Producto -->
    {{#if mostrarForm}}
        <div class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="border-left: 4px solid #E91E63 !important;">
            <h5 class="fw-bold mb-3" style="color: #1a1a2e;">
                {{#if modoEdicion}}Editar Producto{{else}}Nuevo Producto{{/if}}
            </h5>

            <form action="{{#if modoEdicion}}/comercio/productos/{{productoEdit._id}}/editar{{else}}/comercio/productos{{/if}}" method="POST" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Nombre del producto *</label>
                        <input type="text" class="form-control" name="NombreNuevoPorducto" value="{{#if modoEdicion}}{{productoEdit.nombre}}{{/if}}" placeholder="ej. Pizza Margarita" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">categoría *</label>
                        <select class="form-select" name="CategoriaNuevoProducto" required>
                            <option value="">Selecciona una categoría</option>
                            {{#each CategoriaLista}}
                                <option value="{{this._id}}" {{#if ../modoEdicion}}{{#if (eq ../productoEdit.categoriaId this._id)}}selected{{/if}}{{/if}}>
                                    {{this.nombre}}
                                </option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Precio (RD$) *</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="PrecioNuevoProducto" value="{{#if modoEdicion}}{{productoEdit.precio}}{{/if}}" placeholder="550.00" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Foto del producto {{#unless modoEdicion}}*{{else}}(opcional){{/unless}}</label>
                        <input type="file" class="form-control" name="FotoProductoNuevo" accept="image/*" {{#unless modoEdicion}}required{{/unless}}>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">descripción del producto *</label>
                    <textarea class="form-control" rows="2" name="DescripcionNuevoProducto" placeholder="ej. Salsa de tomate artesanal, queso mozzarella fresco y hojas de albahaca" required>{{#if modoEdicion}}{{productoEdit.descripcion}}{{/if}}</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn text-white px-4" style="background-color: #E91E63; border-radius: 8px; font-weight: 600;">
                        {{#if modoEdicion}}Guardar Cambios{{else}}Crear Producto{{/if}}
                    </button>
                    <a href="/comercio/productos" class="btn btn-outline-secondary px-4" style="border-radius: 8px;">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    {{/if}}

    <!-- Tabla de Productos -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">FOTO</th>
                        <th>NOMBRE</th>
                        <th>descripción</th>
                        <th>categoría</th>
                        <th>PRECIO</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productsList}}
                        <tr>
                            <td class="ps-4">
                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 50px; height: 50px; overflow: hidden; border: 1px solid #eee;">
                                    {{#if this.foto}}
                                        <img src="{{this.foto}}" alt="{{this.nombre}}" style="width: 100%; height: 100%; object-fit: cover;">
                                    {{else}}
                                        <span>???</span>
                                    {{/if}}
                                </div>
                            </td>
                            <td class="fw-bold text-dark">{{this.nombre}}</td>
                            <td class="text-muted small" style="max-width: 250px;">{{this.descripcion}}</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
                                    {{this.categoriaId.nombre}}
                                </span>
                            </td>
                            <td class="fw-bold" style="color: #E91E63;">RD$ {{money this.precio}}</td>
                            <td class="text-end pe-4">
                                <a href="/comercio/productosíedit={{this._id}}" class="btn btn-sm btn-outline-primary px-3 me-1" style="border-radius: 8px;">
                                    Editar
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger px-3" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalEliminarProd-{{this._id}}">
                                    Eliminar
                                </button>
                            </td>
                        </tr>

                        <!-- Modal confirmación Eliminar Producto -->
                        <div class="modal fade" id="modalEliminarProd-{{this._id}}" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-dark">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body text-muted py-3">
                                        estás seguro de que deseas eliminar el producto <strong>"{{this.nombre}}"</strong>?
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <form action="/comercio/productos/{{this._id}}/eliminar" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-danger">Aceptar y Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No tienes productos creados todava.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>
