<div class="head-lista-clientes">
   <div class="">
     <h2 class="text-head-list">
        Productos
    </h2>
    <p class="registros"> Gestiona los productos de tu menú

 </p>
    </div>


<button class="Nuevo-tipo-categoria" id="btnNuevoProducto"> + Nuevo Producto </button>

</div>

<section class="nuevo-tipo" id="NuevoProductoSection" hidden>
    <h3 class="nuevo-tipo-text">Nuevo Producto</h3>

<form action="/comercio/productos" method="post">

<div class="NTC-inputs-container row">

      
        <div class="mb-3 col-sm-12 col-md-4 ">
        <label for="NombreNuevoPorducto" class="form-label">Nombre del producto</label>
        <input type="text" class="form-control" id="NombreNuevoPorducto"  name="NombreNuevoPorducto" required>
        </div>
        

        <div class="mb-3 col-sm-12 col-md-4">
        <label for="CategoriaNuevoProducto" class="form-label">Categoría</label>
        <select class="form-select" name="CategoriaNuevoProducto" id="CategoriaNuevoProducto" required>
        {{#each CategoriaLista}}
        
            <option value="{{this._id}}">{{this.nombre}}</option>
        {{/each}}
        </select>
        </div>

        <div class="mb-3 col-sm-12 col-md-4">
        <label for="PrecioNuevoProducto" class="form-label">Precio (RD$)</label>
        <input type="number" class="form-control" id="PrecioNuevoProducto"  name="PrecioNuevoProducto" required>
        </div>

         <div class="mb-3">
        <label for="DescripcionNuevoProducto" class="form-label">Descripción</label>
        <input type="text" class="form-control" id="DescripcionNuevoProducto"  name="DescripcionNuevoProducto" required>
        </div>

         <div class="mb-3 ">
        <label for="FotoProductoNuevo" class="form-label">Foto del producto</label>
        <input type="file" class="form-control" id="FotoProductoNuevo"  name="FotoProductoNuevo" required>
        </div>

    </div>

    <div class="btones">
        <button class="btn btn-primary Nuevo-tipo-comercio" id="envu" type="submit">Crear</button>
        <button type="button" class="btn btn-secondary" id="btnCancelarNuevoProducto">Cancelar</button>


    </div>
    </form>
    


</section>

<section class="lista-categorias">




<table class="tabla-categorias">

    <thead>
      <tr>
        <th>Foto</th>
        <th>Nombre</th>
        <th>Descripción</th>
        <th>Categoría</th>
        <th>Precio</th>
        <th>Accciones</th>
        
      </tr>
    </thead>

    <tbody>
       
    {{#each productsList}}
    <tr>
      <td>{{this.foto}}</td>
      <td>{{this.nombre}}</td>
      <td>{{this.Descripción}}</td>
       <th>{{this.categoriaId}}</th>
        <th>{{this.precio}}</th>
      <td><button class="btn btn-sm btn-primary">editar</button> eliminar<button></button></td>
    </tr>
  {{/each}}


    </tbody>

</table>













   

</section>