<section class="perfil-section container" style="max-width: 700px; margin-top: 100px; margin-bottom: 60px;">
    <div class="perfil-card">
        <h3 class="fw-bold mb-4 text-center" style="color: #1a1a2e;">Perfil del Comercio</h3>

        {{#if successMsg}}
            <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3" role="alert">
                {{successMsg}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {{/if}}

        {{#if errorMsg}}
            <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
                {{errorMsg}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {{/if}}

        <form action="/comercio/perfil" method="POST" enctype="multipart/form-data">
            <!-- Logo avatar -->
            <div class="text-center mb-4">
                <div class="position-relative d-inline-block">
                    <div class="avatar mx-auto mb-2" style="width: 90px; height: 90px; overflow: hidden; font-size: 32px;">
                        {{#if comercio.logoComercio}}
                            <img src="{{comercio.logoComercio}}" alt="Logo" style="width: 100%; height: 100%; object-fit: cover;">
                        {{else}}
                            <span>??</span>
                        {{/if}}
                    </div>
                </div>
                <div>
                    <label for="logoComercio" class="btn btn-sm btn-outline-secondary" style="border-radius: 20px; font-size: 12px; cursor: pointer;">
                        ?? Cambiar logo
                    </label>
                    <input type="file" id="logoComercio" name="logoComercio" class="d-none" accept="image/*">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre del comercio *</label>
                <input type="text" name="nombreComercio" class="form-control" value="{{comercio.nombreComercio}}" required>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">teléfono *</label>
                    <input type="text" name="telefono" class="form-control" value="{{comercio.telefono}}" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Correo electrónico</label>
                    <input type="email" class="form-control bg-light" value="{{comercio.correo}}" disabled readonly>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Hora de apertura *</label>
                    <input type="time" name="horaApertura" class="form-control" value="{{comercio.horaApertura}}" required>
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Hora de cierre *</label>
                    <input type="time" name="horaCierre" class="form-control" value="{{comercio.horaCierre}}" required>
                </div>
            </div>

            <div class="d-flex gap-3">
                <a href="/comercio/home" class="btn btn-outline-secondary w-50 py-2" style="border-radius: 10px;">
                    Volver
                </a>
                <button type="submit" class="btn text-white w-50 py-2" style="background: linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91)); border-radius: 10px; font-weight: 600;">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</section>
