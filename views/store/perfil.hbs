<div class="app-container" style="max-width: 580px;">
    <h3 class="fw-bold mb-4 text-center" style="color: #1A1A2E; font-size: 22px;">Perfil del Comercio</h3>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <form action="/comercio/perfil" method="POST" enctype="multipart/form-data">
            <!-- Logo avatar -->
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-2 text-white" 
                     style="width: 76px; height: 76px; background: #FFF5F7; border: 1px solid #FCE4EC; font-size: 36px; overflow: hidden;">
                    {{#if comercio.logoComercio}}
                        <img src="{{comercio.logoComercio}}" alt="Logo" style="width: 100%; height: 100%; object-fit: cover;">
                    {{else}}
                        🍕
                    {{/if}}
                </div>
                <div>
                    <label for="logoComercio" class="btn btn-link p-0 text-decoration-none" style="color: #E91E63; font-size: 12.5px; font-weight: 500; cursor: pointer;">
                        Cambiar logo
                    </label>
                    <input type="file" id="logoComercio" name="logoComercio" class="d-none" accept="image/*">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Nombre del comercio</label>
                <input type="text" name="nombreComercio" class="form-control" value="{{comercio.nombreComercio}}" required style="font-size: 13.5px;">
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Teléfono</label>
                    <input type="text" name="telefono" class="form-control" value="{{comercio.telefono}}" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Correo</label>
                    <input type="email" class="form-control bg-light" value="{{comercio.correo}}" disabled readonly style="font-size: 13.5px;">
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Hora de apertura</label>
                    <input type="text" name="horaApertura" class="form-control" value="{{comercio.horaApertura}}" placeholder="11:00 AM" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Hora de cierre</label>
                    <input type="text" name="horaCierre" class="form-control" value="{{comercio.horaCierre}}" placeholder="11:00 PM" required style="font-size: 13.5px;">
                </div>
            </div>

            <div>
                <button type="submit" class="btn-pink-primary w-100 py-2" style="font-size: 14px;">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>
