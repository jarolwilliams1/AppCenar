<div class="app-container" style="max-width: 820px;">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Pedidos Recibidos</h3>
        <p class="text-muted small mb-0">Gestiona los pedidos de tu comercio en tiempo real</p>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <div class="d-flex flex-column gap-3">
        {{#each pedidos}}
            <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <!-- Fila 1: Número de Pedido, Estado y Monto -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark" style="font-size: 15px;">Pedido #{{this._id}}</span>
                        <span class="badge {{statusBadge this.estado}} rounded-pill px-3 py-1" style="font-size: 11px;">
                            {{statusLabel this.estado}}
                        </span>
                    </div>
                    <span class="fw-bold" style="color: #E91E63; font-size: 15.5px;">RD${{money this.total}}</span>
                </div>

                <!-- Fila 2: Cliente y Fecha -->
                <div class="text-muted small mb-2" style="font-size: 12.5px;">
                    {{this.clienteId.nombre}} {{this.clienteId.apellido}} · {{formatDate this.createdAt}} · {{this.productos.length}} productos
                    {{#if this.deliveryId}}
                        <span class="ms-2 text-primary fw-semibold">Delivery: {{this.deliveryId.nombre}} {{this.deliveryId.apellido}}</span>
                    {{/if}}
                </div>

                <!-- Fila 3: Lista de Productos -->
                <div class="text-dark small mb-2 fw-medium" style="font-size: 13.5px;">
                    {{#each this.productos}}
                        {{this.nombre}}{{#unless @last}} · {{/unless}}
                    {{/each}}
                </div>

                <!-- Fila 4: Dirección y Acción Asignar Delivery -->
                <div class="d-flex justify-content-between align-items-center pt-2 flex-wrap gap-2">
                    <div class="text-muted small" style="font-size: 12.5px;">
                        {{this.direccion.nombre}} - {{this.direccion.descripcion}}
                    </div>

                    <div>
                        {{#if (eq this.estado "pendiente")}}
                            <form action="/comercio/pedidos/{{this._id}}/asignar-delivery" method="POST" class="m-0">
                                <button type="submit" class="btn-pink-primary">
                                    Asignar Delivery
                                </button>
                            </form>
                        {{else if (eq this.estado "en_proceso")}}
                            <span class="badge badge-status-proceso">
                                Delivery en camino
                            </span>
                        {{else if (eq this.estado "completado")}}
                            <span class="badge badge-status-completado">
                                Completado
                            </span>
                        {{/if}}
                    </div>
                </div>
            </div>
        {{else}}
            <div class="card border-0 shadow-sm p-5 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <p class="text-muted mb-0">No hay pedidos recibidos por el momento.</p>
            </div>
        {{/each}}
    </div>
</div>
