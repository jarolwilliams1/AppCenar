<div class="app-container-wide">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Listado de Deliveries</h3>
        <p class="text-muted small mb-0">{{totalDeliveries}} repartidores registrados</p>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <div class="table-responsive">
            <table class="table table-app align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">NOMBRE</th>
                        <th>USUARIO</th>
                        <th>CORREO</th>
                        <th>TELÉFONO</th>
                        <th>ENTREGAS</th>
                        <th>DISPONIBILIDAD</th>
                        <th>ESTADO</th>
                        <th class="text-end pe-4">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each listaDeliveries}}
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">{{this.nombre}} {{this.apellido}}</td>
                            <td class="text-muted small">@{{this.usuario}}</td>
                            <td class="text-muted small">{{this.correo}}</td>
                            <td class="text-muted small">{{this.telefono}}</td>
                            <td>
                                <span class="badge rounded-pill px-2 py-1 fw-semibold" style="background-color: #FCE4EC; color: #E91E63; font-size: 11.5px;">
                                    {{this.totalEntregas}}
                                </span>
                            </td>
                            <td>
                                {{#if (eq this.estadoDelivery "Disponible")}}
                                    <span class="small fw-semibold" style="color: #2E7D32;">Libre</span>
                                {{else}}
                                    <span class="small fw-semibold" style="color: #E65100;">Ocupado</span>
                                {{/if}}
                            </td>
                            <td>
                                {{#if this.isActive}}
                                    <span class="fw-semibold" style="color: #2E7D32; font-size: 12.5px;">Activo</span>
                                {{else}}
                                    <span class="fw-semibold" style="color: #E53935; font-size: 12.5px;">Inactivo</span>
                                {{/if}}
                            </td>
                            <td class="text-end pe-4">
                                <form action="/admin/deliveries/{{this._id}}/toggle-status" method="POST" class="m-0">
                                    {{#if this.isActive}}
                                        <button type="submit" class="btn-danger-pill">
                                            Inactivar
                                        </button>
                                    {{else}}
                                        <button type="submit" class="btn-success-pill">
                                            Activar
                                        </button>
                                    {{/if}}
                                </form>
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                No hay repartidores registrados.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>
