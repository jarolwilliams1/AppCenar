<div class="app-container-wide">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Administradores</h3>
            <p class="text-muted small mb-0">Gestiona las cuentas de administrador</p>
        </div>
        <button type="button" class="btn-pink-primary" onclick="toggleFormAdmin()">
            + Nuevo Admin
        </button>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Formulario Inline / Colapsable de Nuevo Administrador -->
    <div id="formAdminCard" class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="background: #FFFFFF; border: 1px solid #EEF2F6; display: none;">
        <h5 class="fw-bold text-dark mb-3" style="font-size: 15px;">Nuevo administrador</h5>
        <form action="/admin/administradores" method="POST">
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Cédula</label>
                    <input type="text" class="form-control" name="cedula" placeholder="001-0000000-0" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Usuario</label>
                    <input type="text" class="form-control" name="usuario" placeholder="admin_nombre" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Correo</label>
                    <input type="email" class="form-control" name="correo" placeholder="admin@appcenar.com" required style="font-size: 13.5px;">
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Nombre</label>
                    <input type="text" class="form-control" name="nombre" placeholder="Nombre" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Apellido</label>
                    <input type="text" class="form-control" name="apellido" placeholder="Apellido" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Contraseña</label>
                    <input type="password" class="form-control" name="password" placeholder="••••••••" required style="font-size: 13.5px;">
                    <input type="hidden" name="confirmPassword" value="">
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-pink-primary" onclick="syncPass(this.form)">Crear</button>
                <button type="button" class="btn-cancel-custom" onclick="toggleFormAdmin()">Cancelar</button>
            </div>
        </form>
    </div>

    <!-- Tabla de Administradores -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <div class="table-responsive">
            <table class="table table-app align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">CÉDULA</th>
                        <th>USUARIO</th>
                        <th>CORREO</th>
                        <th>ESTADO</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each listaAdmins}}
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">{{this.cedula}}</td>
                            <td>
                                @{{this.usuario}}
                                {{#if this.esAdminActual}}
                                    <span class="badge rounded-pill px-2 py-0 ms-1 fw-semibold" style="background-color: #FCE4EC; color: #E91E63; font-size: 10px;">Tú</span>
                                {{/if}}
                                {{#if this.esAdminDefecto}}
                                    <span class="badge rounded-pill px-2 py-0 ms-1 fw-semibold" style="background-color: #FFF3E0; color: #E65100; font-size: 10px;">Sistema</span>
                                {{/if}}
                            </td>
                            <td class="text-muted small">{{this.correo}}</td>
                            <td>
                                {{#if this.isActive}}
                                    <span class="fw-semibold" style="color: #2E7D32; font-size: 12.5px;">Activo</span>
                                {{else}}
                                    <span class="fw-semibold" style="color: #E53935; font-size: 12.5px;">Inactivo</span>
                                {{/if}}
                            </td>
                            <td class="text-end pe-4">
                                {{#if this.puedeModificar}}
                                    <button type="button" class="btn-outline-custom me-1" data-bs-toggle="modal" data-bs-target="#modalEditarAdmin-{{this._id}}">
                                        Editar
                                    </button>

                                    <form action="/admin/administradores/{{this._id}}/toggle-status" method="POST" class="d-inline m-0">
                                        {{#if this.isActive}}
                                            <button type="submit" class="btn-danger-pill">
                                                Inactivar
                                            </button>
                                        {{else}}
                                            <button type="submit" class="btn-success-pill">
                                                Activar
                                            </button>
                                        {{/if}}
                                    </form>

                                    <!-- Modal Editar Administrador -->
                                    <div class="modal fade" id="modalEditarAdmin-{{this._id}}" tabindex="-1" aria-labelledby="modalEditarAdminLabel-{{this._id}}" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-dark" id="modalEditarAdminLabel-{{this._id}}">Editar Administrador</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form action="/admin/administradores/{{this._id}}/editar" method="POST">
                                                    <div class="modal-body py-3 text-start">
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small fw-semibold">Cédula</label>
                                                            <input type="text" class="form-control" name="cedula" value="{{this.cedula}}" required style="font-size: 13.5px;">
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-6">
                                                                <label class="form-label text-muted small fw-semibold">Nombre</label>
                                                                <input type="text" class="form-control" name="nombre" value="{{this.nombre}}" required style="font-size: 13.5px;">
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="form-label text-muted small fw-semibold">Apellido</label>
                                                                <input type="text" class="form-control" name="apellido" value="{{this.apellido}}" required style="font-size: 13.5px;">
                                                            </div>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small fw-semibold">Usuario</label>
                                                            <input type="text" class="form-control" name="usuario" value="{{this.usuario}}" required style="font-size: 13.5px;">
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small fw-semibold">Correo</label>
                                                            <input type="email" class="form-control" name="correo" value="{{this.correo}}" required style="font-size: 13.5px;">
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small fw-semibold">Nueva Contraseña (opcional)</label>
                                                            <input type="password" class="form-control" name="password" placeholder="Dejar en blanco para mantener la actual" style="font-size: 13.5px;">
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn-cancel-custom" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn-pink-primary">Guardar Cambios</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                {{else}}
                                    <span class="text-muted small fst-italic">Protegido</span>
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleFormAdmin() {
        const card = document.getElementById('formAdminCard');
        card.style.display = card.style.display === 'none' ? 'block' : 'none';
        if (card.style.display === 'block') card.scrollIntoView({ behavior: 'smooth' });
    }
    function syncPass(form) {
        if (form.password && form.confirmPassword) {
            form.confirmPassword.value = form.password.value;
        }
    }
</script>
