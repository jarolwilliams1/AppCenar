<div class="app-container-wide">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Dashboard</h3>
        <p class="text-muted small mb-0">Panel analítico de AppCenar</p>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Sección Pedidos -->
    <div class="mb-4">
        <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">PEDIDOS</div>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">TOTAL HISTÓRICO</span>
                        <span>📦</span>
                    </div>
                    <div class="fw-bold my-1 text-dark" style="font-size: 28px;">{{metrics.totalPedidos}}</div>
                    <small class="text-muted" style="font-size: 11.5px;">Desde el inicio de la plataforma</small>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">PEDIDOS HOY</span>
                        <span>📅</span>
                    </div>
                    <div class="fw-bold my-1 text-dark" style="font-size: 28px;">{{metrics.pedidosHoy}}</div>
                    <small class="text-muted" style="font-size: 11.5px;">1 agosto 2026</small>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">PRODUCTOS TOTALES</span>
                        <span>🍽️</span>
                    </div>
                    <div class="fw-bold my-1 text-dark" style="font-size: 28px;">{{metrics.totalProductos}}</div>
                    <small class="text-muted" style="font-size: 11.5px;">En todos los comercios</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección Usuarios -->
    <div class="mb-4">
        <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">USUARIOS</div>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">COMERCIOS ACTIVOS</span>
                        <span>🏪</span>
                    </div>
                    <div class="fw-bold my-1 text-dark" style="font-size: 28px;">{{metrics.comerciosActivos}}</div>
                    <small class="text-muted" style="font-size: 11.5px;">{{metrics.comerciosInactivos}} inactivos</small>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">CLIENTES ACTIVOS</span>
                        <span>👤</span>
                    </div>
                    <div class="fw-bold my-1 text-dark" style="font-size: 28px;">{{metrics.clientesActivos}}</div>
                    <small class="text-muted" style="font-size: 11.5px;">{{metrics.clientesInactivos}} inactivos</small>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">DELIVERIES ACTIVOS</span>
                        <span>🛵</span>
                    </div>
                    <div class="fw-bold my-1 text-dark" style="font-size: 28px;">{{metrics.deliveriesActivos}}</div>
                    <small class="text-muted" style="font-size: 11.5px;">{{metrics.deliveriesInactivos}} inactivos</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filas inferiores: Pedidos recientes y Top comercios -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 rounded-4 h-100" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <h6 class="fw-bold mb-3" style="color: #1A1A2E; font-size: 15px;">Pedidos recientes</h6>
                <div class="d-flex flex-column gap-2">
                    {{#each pedidosRecientes}}
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="fw-semibold text-dark" style="font-size: 13.5px;">{{this.clienteId.nombre}} {{this.clienteId.apellido}}</div>
                                <small class="text-muted" style="font-size: 12px;">{{this.comercioId.nombreComercio}}</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold" style="color: #E91E63; font-size: 13.5px;">RD${{money this.total}}</div>
                                <span class="badge {{statusBadge this.estado}} rounded-pill px-2 py-0" style="font-size: 10px;">{{statusLabel this.estado}}</span>
                            </div>
                        </div>
                    {{else}}
                        <p class="text-muted small mb-0">No hay pedidos registrados.</p>
                    {{/each}}
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 rounded-4 h-100" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                <h6 class="fw-bold mb-3" style="color: #1A1A2E; font-size: 15px;">Top comercios</h6>
                <div class="d-flex flex-column gap-3">
                    {{#each topComercios}}
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span>🍕</span>
                                    <span class="fw-semibold text-dark" style="font-size: 13.5px;">{{this.nombreComercio}}</span>
                                </div>
                                <span class="text-muted small fw-semibold" style="font-size: 12px;">
                                    {{this.totalPedidos}}
                                </span>
                            </div>
                            <div class="progress" style="height: 4px; border-radius: 4px; background-color: #FCE4EC;">
                                <div class="progress-bar" role="progressbar" style="width: 75%; background-color: #E91E63;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    {{else}}
                        <p class="text-muted small mb-0">No hay datos de comercios.</p>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>
