<section class="container" style="max-width: 1100px; margin-top: 90px; margin-bottom: 60px;">
    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color: #1a1a2e;">Dashboard</h2>
        <p class="text-muted">Panel analtico de AppCenar</p>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">PEDIDOS Y catálogo</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <span class="text-muted small fw-bold text-uppercase">TOTAL histórico</span>
                <strong class="fs-2 my-1" style="color: #1a1a2e;">{{metrics.totalPedidos}}</strong>
                <small class="text-muted">Desde el inicio de la plataforma</small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <span class="text-muted small fw-bold text-uppercase">PEDIDOS HOY</span>
                <strong class="fs-2 my-1" style="color: #E91E63;">{{metrics.pedidosHoy}}</strong>
                <small class="text-muted">óórdenes generadas hoy</small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <span class="text-muted small fw-bold text-uppercase">PRODUCTOS TOTALES</span>
                <strong class="fs-2 my-1" style="color: #1a1a2e;">{{metrics.totalProductos}}</strong>
                <small class="text-muted">En todos los comercios</small>
            </div>
        </div>
    </div>

    <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">ESTADO DE USUARIOS</h6>
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <span class="text-muted small fw-bold text-uppercase">COMERCIOS ACTIVOS</span>
                <strong class="fs-2 my-1 text-success">{{metrics.comerciosActivos}}</strong>
                <small class="text-danger fw-bold">{{metrics.comerciosInactivos}} inactivos</small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <span class="text-muted small fw-bold text-uppercase">CLIENTES ACTIVOS</span>
                <strong class="fs-2 my-1 text-success">{{metrics.clientesActivos}}</strong>
                <small class="text-danger fw-bold">{{metrics.clientesInactivos}} inactivos</small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <span class="text-muted small fw-bold text-uppercase">DELIVERIES ACTIVOS</span>
                <strong class="fs-2 my-1 text-success">{{metrics.deliveriesActivos}}</strong>
                <small class="text-danger fw-bold">{{metrics.deliveriesInactivos}} inactivos</small>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-3" style="color: #1a1a2e;">Pedidos Recientes</h5>
                <div class="d-flex flex-column gap-2">
                    {{#each pedidosRecientes}}
                        <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                            <div>
                                <span class="fw-bold text-dark">{{this.clienteId.nombre}} {{this.clienteId.apellido}}</span>
                                <small class="text-muted d-block">{{this.comercioId.nombreComercio}}</small>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold text-dark d-block">RD$ {{money this.total}}</span>
                                <span class="badge {{statusBadge this.estado}} rounded-pill px-2" style="font-size: 10px;">{{statusLabel this.estado}}</span>
                            </div>
                        </div>
                    {{else}}
                        <p class="text-muted small mb-0">No hay pedidos registrados.</p>
                    {{/each}}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-3" style="color: #1a1a2e;">Top Comercios</h5>
                <div class="d-flex flex-column gap-3">
                    {{#each topComercios}}
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span>??</span>
                                <span class="fw-bold text-dark">{{this.nombreComercio}}</span>
                            </div>
                            <span class="badge bg-light text-dark border px-3 py-1 rounded-pill">
                                {{this.totalPedidos}} pedidos
                            </span>
                        </div>
                    {{else}}
                        <p class="text-muted small mb-0">No hay datos de comercios.</p>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</section>
