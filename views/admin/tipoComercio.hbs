<section class="container" style="max-width: 950px; margin-top: 90px; margin-bottom: 60px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1a1a2e;">Tipos de Comercio</h2>
            <p class="text-muted mb-0">categorías globales que aparecen en el home del cliente</p>
        </div>
        {{#unless mostrarForm}}
            <a href="/admin/tipo-comercio?nuevo=1" class="btn text-white px-3 py-2" style="background: linear-gradient(135deg, rgb(233, 30, 99), rgb(194, 24, 91)); border-radius: 10px; font-weight: 600; font-size: 13px;">
                + Nuevo Tipo
            </a>
        {{/unless}}
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if mostrarForm}}
        <div class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="border-left: 4px solid #E91E63 !important;">
            <h5 class="fw-bold mb-3" style="color: #1a1a2e;">
                {{#if modoEdicion}}Editar Tipo de Comercio{{else}}Nuevo Tipo de Comercio{{/if}}
            </h5>

            <form action="{{#if modoEdicion}}/admin/tipo-comercio/{{tipoEdit._id}}/editar{{else}}/admin/tipo-comercio{{/if}}" method="POST" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Nombre del tipo *</label>
                        <input type="text" class="form-control" name="nombeNuevoTipoComercioInput" value="{{#if modoEdicion}}{{tipoEdit.nombre}}{{/if}}" placeholder="ej. Restaurante, Farmacia" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">ícono (archivo) {{#if modoEdicion}}(opcional){{/if}}</label>
                        <input type="file" class="form-control" name="iconoNuevoTipoComercioAdminInput" accept="image/*">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">descripción *</label>
                    <textarea class="form-control" rows="2" name="descripcionNuevoTipoComercioInput" placeholder="ej. Comida preparada y restaurantes" required>{{#if modoEdicion}}{{tipoEdit.descripcion}}{{/if}}</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn text-white px-4" style="background-color: #E91E63; border-radius: 8px; font-weight: 600;">
                        {{#if modoEdicion}}Guardar Cambios{{else}}Crear Tipo{{/if}}
                    </button>
                    <a href="/admin/tipo-comercio" class="btn btn-outline-secondary px-4" style="border-radius: 8px;">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    {{/if}}

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ícono</th>
                        <th>NOMBRE</th>
                        <th>descripción</th>
                        <th>COMERCIOS</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each listaTiposComercio}}
                        <tr>
                            <td class="ps-4" style="font-size: 24px;">
                                {{#if this.icono}}
                                    {{#if (eq this.icono "??")}}??{{else if (eq this.icono "??")}}??{{else if (eq this.icono "??")}}??{{else if (eq this.icono "??")}}??{{else if (eq this.icono "?")}}?{{else if (eq this.icono "??")}}??{{else}}<img src="{{this.icono}}" alt="{{this.nombre}}" style="width: 32px; height: 32px; object-fit: contain;">{{/if}}
                                {{else}}
                                    ???
                                {{/if}}
                            </td>
                            <td class="fw-bold text-dark">{{this.nombre}}</td>
                            <td class="text-muted small" style="max-width: 250px;">{{this.descripcion}}</td>
                            <td>
                                <span class="badge bg-light text-primary border px-2 py-1 rounded-pill fw-bold">
                                    {{this.totalComercios}} comercios
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="/admin/tipo-comercio?edit={{this._id}}" class="btn btn-sm btn-outline-primary px-3 me-1" style="border-radius: 8px;">
                                    Editar
                                </a>

                                <button type="button" class="btn btn-sm btn-outline-danger px-3" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalEliminarTipo-{{this._id}}">
                                    Eliminar
                                </button>

                                <div class="modal fade" id="modalEliminarTipo-{{this._id}}" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold text-danger">?? Confirmar eliminación en cascada</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-muted py-3 text-start">
                                                estás seguro que deseas eliminar este tipo de comercio (<strong>{{this.nombre}}</strong>) y <strong>todos los comercios y productos asociados a este tipo</strong>? Esta acción no se puede deshacer.
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form action="/admin/tipo-comercio/{{this._id}}/eliminar" method="POST" class="m-0">
                                                    <button type="submit" class="btn btn-danger">sí, eliminar todo en cascada</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                No hay tipos de comercio creados todava.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>
