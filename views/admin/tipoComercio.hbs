<div class="app-container-wide">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1A1A2E; font-size: 22px;">Tipos de Comercio</h3>
            <p class="text-muted small mb-0">Categorías globales para comercios</p>
        </div>
        <button type="button" class="btn-pink-primary" onclick="toggleFormTipo()">
            + Nuevo Tipo
        </button>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Formulario Inline / Colapsable de Nuevo Tipo de Comercio -->
    <div id="formTipoCard" class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="background: #FFFFFF; border: 1px solid #EEF2F6; display: none;">
        <h5 class="fw-bold text-dark mb-3" style="font-size: 15px;">Nuevo tipo de comercio</h5>
        <form action="/admin/tipo-comercio" method="POST" enctype="multipart/form-data">
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Nombre</label>
                    <input type="text" class="form-control" name="nombeNuevoTipoComercioInput" placeholder="Hamburguesas" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Ícono (imagen o foto)</label>
                    <input type="file" class="form-control" name="iconoNuevoTipoComercioAdminInput" accept="image/*" style="font-size: 13.5px;">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Descripción</label>
                <input type="text" class="form-control" name="descripcionNuevoTipoComercioInput" placeholder="Hamburguesas artesanales y combos" required style="font-size: 13.5px;">
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-pink-primary">Crear</button>
                <button type="button" class="btn-cancel-custom" onclick="toggleFormTipo()">Cancelar</button>
            </div>
        </form>
    </div>

    <!-- Tabla de Tipos de Comercio -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <div class="table-responsive">
            <table class="table table-app align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ÍCONO</th>
                        <th>NOMBRE</th>
                        <th>DESCRIPCIÓN</th>
                        <th>COMERCIOS</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each listaTiposComercio}}
                        <tr>
                            <td class="ps-4">
                                {{#if this.icono}}
                                    <img src="{{this.icono}}" alt="{{this.nombre}}" style="width: 32px; height: 32px; object-fit: contain;">
                                {{else}}
                                    <div class="logo-square" style="width: 30px; height: 30px; font-size: 11px; margin: 0;">AC</div>
                                {{/if}}
                            </td>
                            <td class="fw-semibold text-dark">{{this.nombre}}</td>
                            <td class="text-muted small">{{this.descripcion}}</td>
                            <td>
                                <span class="badge rounded-pill px-3 py-1 fw-semibold" style="background-color: #E1F5FE; color: #0288D1; font-size: 11.5px;">
                                    {{this.totalComercios}} comercios
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn-outline-custom me-1" data-bs-toggle="modal" data-bs-target="#modalEditarTipo-{{this._id}}">
                                    Editar
                                </button>
                                <button type="button" class="btn-danger-pill" data-bs-toggle="modal" data-bs-target="#modalEliminarTipo-{{this._id}}">
                                    Eliminar
                                </button>
                            </td>
                        </tr>

                        <!-- Modal Editar Tipo de Comercio -->
                        <div class="modal fade" id="modalEditarTipo-{{this._id}}" tabindex="-1" aria-labelledby="modalEditarTipoLabel-{{this._id}}" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-dark" id="modalEditarTipoLabel-{{this._id}}">Editar Tipo de Comercio</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form action="/admin/tipo-comercio/{{this._id}}/editar" method="POST" enctype="multipart/form-data">
                                        <div class="modal-body py-3 text-start">
                                            <div class="mb-3">
                                                <label class="form-label text-muted small fw-semibold">Nombre</label>
                                                <input type="text" class="form-control" name="nombeNuevoTipoComercioInput" value="{{this.nombre}}" required style="font-size: 13.5px;">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-muted small fw-semibold">Cambiar Ícono (opcional)</label>
                                                <input type="file" class="form-control" name="iconoNuevoTipoComercioAdminInput" accept="image/*" style="font-size: 13.5px;">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-muted small fw-semibold">Descripción</label>
                                                <textarea class="form-control" rows="2" name="descripcionNuevoTipoComercioInput" required style="font-size: 13.5px;">{{this.descripcion}}</textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn-cancel-custom" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn-pink-primary">Guardar Cambios</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Confirmación Eliminación en Cascada -->
                        <div class="modal fade" id="modalEliminarTipo-{{this._id}}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-danger">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-muted py-3 text-start" style="font-size: 13.5px;">
                                        ¿Estás seguro de que deseas eliminar <strong>"{{this.nombre}}"</strong> y todos los comercios, productos y pedidos asociados?
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn-cancel-custom" data-bs-dismiss="modal">Cancelar</button>
                                        <form action="/admin/tipo-comercio/{{this._id}}/eliminar" method="POST" class="m-0">
                                            <button type="submit" class="btn-danger-pill">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                No hay tipos de comercio registrados.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleFormTipo() {
        const card = document.getElementById('formTipoCard');
        card.style.display = card.style.display === 'none' ? 'block' : 'none';
        if (card.style.display === 'block') card.scrollIntoView({ behavior: 'smooth' });
    }
</script>
