<div class="head-lista-clientes">
   <div class="">
     <h2 class="text-head-list">
        Listado de Clientes
    </h2>
    <p class="registros">{{cantidad}} clientes registrados </p>
    </div>


<button class="Nuevo-tipo-comercio" id="nuevoTipoComercio"> + Nuevo Tipo </button>

</div>

<section class="nuevo-tipo" id="NuevoTipoSection" hidden>
    <h3 class="nuevo-tipo-text">Nuevo tipo de comercio</h3>

<form action="/admin/tipo-comercio" method="post">
<div class="NTC-inputs-container">

        <div class="mb-3">
        <label for="iconoNuevoTipoComercioAdminInput" class="form-label">Icono</label>
        <input type="file" class="form-control" id="iconoNuevoTipoComercioAdminInput"  name="iconoNuevoTipoComercioAdminInput">
        </div>


        <div class="mb-3">
        <label for="nombeNuevoTipoComercioInput" class="form-label">Nombre</label>
        <input type="text" class="form-control" id="nombeNuevoTipoComercioInput" placeholder="ej.Restaurante" name="nombeNuevoTipoComercioInput" required>
        </div>
        

        <div class="mb-3">
        <label for="descripcionNuevoTipoComercioInput" class="form-label">Descripcion</label>
        <input type="text" class="form-control" id="descripcionNuevoTipoComercioInput"  name="descripcionNuevoTipoComercioInput" required>
        </div>

    </div>

    <div class="btones">
        <button class="Nuevo-tipo-comercio" id="envu" type="submit">Crear</button>
        <button type="button" class="btn btn-secondary" id="btnCancelarTipoComercio">Cancelar</button>


    </div>
    </form>
    


</section>

<section class="lista-clientes">




<table class="tabla-clientes">

    <thead>
      <tr>
        <th>Icono</th>
        <th>Nombre</th>
        <th>Descripcion</th>
        <th>Comercios</th>
        <th>Acciones</th>
        
      </tr>
    </thead>

    <tbody>
       
    {{#each listaTiposComercio}}
    <tr>
      <td>{{this.icono}}</td>
      <td>{{this.nombre}}</td>
      <td>{{this.descripcion}}</td>
      <td>hola</td>
      <td><button class="btn btn-sm btn-primary">Acción</button></td>
    </tr>
  {{/each}}


    </tbody>

</table>













   

</section>