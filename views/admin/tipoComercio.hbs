    </div>


<button class="Nuevo-tipo-comercio" id="nuevoTipoComercio"> + Nuevo Tipo </button>

</div>

<section class="nuevo-tipo" id="NuevoTipoSection" hidden>
    <h3 class="nuevo-tipo-text">Nuevo tipo de comercio</h3>

<form action="" method="get">
<div class="NTC-inputs-container">

        <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Usuario</label>
        <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="ej.cliente" name="usuario" required>
        </div>


        <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Usuario</label>
        <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="ej.cliente" name="usuario" required>
        </div>
        

        <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Usuario</label>
        <input type="text" class="form-control" id="exampleFormControlInput1" placeholder="ej.cliente" name="usuario" required>
        </div>

    </div>

    <div class="btones">
        <button class="Nuevo-tipo-comercio" id="envu" type="submit">Crear</button>
        <button type="button" class="btn btn-secondary" id="btnCancelarTipoComercio">Cancelar</button>


    </div>
    </form>
    


</section>

<section class="lista-clientes">




<table class="tabla-clientes">

    <thead>
      <tr>
        <th>Nombre</th>
        <th>Apellido</th>
        <th>Correo</th>
        <th>Telefono</th>
        <th>Disponibilidad</th>
        <th>Entregas</th>
        <th>Estado</th>
        <th>Accion</th>
      </tr>
    </thead>

    <tbody>
       
    {{#each listaDeliveries}}
    <tr>
      <td>{{this.nombre}}</td>
      <td>{{this.apellido}}</td>
      <td>{{this.correo}}</td>
      <td>{{this.telefono}}</td>
      <td>{{#if this.estadoDelivery}}Libre{{else}}Ocupado{{/if}}</td>
      <td>hola</td>
      <td>{{#if this.isActive}}Activo{{else}}Inactivo{{/if}}</td>
      <td><button class="btn btn-sm btn-primary">Acción</button></td>
    </tr>
  {{/each}}


    </tbody>

</table>













   

</section>