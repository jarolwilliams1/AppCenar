<div class="app-container" style="max-width: 780px;">
    <!-- Banner de Estado Actual -->
    <div class="p-4 rounded-4 mb-4 text-white d-flex justify-content-between align-items-center" 
         style="background: linear-gradient(135deg, #0288D1, #01579B); border-radius: 20px; box-shadow: 0 4px 16px rgba(2, 136, 209, 0.2);">
        <div>
            <span class="text-uppercase small opacity-75 fw-semibold" style="font-size: 11.5px; letter-spacing: 0.05em;">Estado actual</span>
            <h3 class="fw-bold mb-1" style="font-size: 20px;">
                {{#if (eq delivery.estadoDelivery "Ocupado")}}
                    Ocupado
                {{else}}
                    Libre / Disponible
                {{/if}}
            </h3>
            <p class="mb-0 small opacity-90" style="font-size: 12.5px;">
                {{entregasEnCurso.length}} entrega(s) pendiente(s)
            </p>
        </div>
    </div>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <!-- Entregas en curso -->
    <div class="mb-4">
        <h5 class="fw-bold mb-3" style="color: #1A1A2E; font-size: 16px;">Entregas en curso</h5>

        <div class="d-flex flex-column gap-3">
            {{#each entregasEnCurso}}
                <a href="/delivery/pedidos/{{this._id}}" class="text-decoration-none text-dark">
                    <div class="card border-0 shadow-sm p-3 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 44px; height: 44px; font-size: 13px;">
                                    <div class="logo-square" style="width: 36px; height: 36px; font-size: 13px; margin: 0; background: linear-gradient(135deg, #0288D1, #01579B);">AC</div>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark mb-0" style="font-size: 14.5px;">Pedido #{{this._id}}</div>
                                    <small class="text-muted d-block" style="font-size: 12px;">{{this.comercioId.nombreComercio}} · Para: {{this.clienteId.nombre}} {{this.clienteId.apellido}}</small>
                                    <small class="text-muted" style="font-size: 12px;">{{this.direccion.nombre}} - {{this.direccion.descripcion}}</small>
                                </div>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold mb-1" style="color: #E91E63; font-size: 14.5px;">RD${{money this.total}}</div>
                                <span class="badge badge-status-proceso">
                                    En Proceso
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            {{else}}
                <div class="card border-0 shadow-sm p-4 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <p class="text-muted mb-0 small">No tienes pedidos pendientes de entrega.</p>
                </div>
            {{/each}}
        </div>
    </div>

    <!-- Entregas completadas -->
    <div>
        <h5 class="fw-bold mb-3" style="color: #1A1A2E; font-size: 16px;">Entregas completadas</h5>

        <div class="d-flex flex-column gap-3">
            {{#each entregasCompletadas}}
                <div class="card border-0 shadow-sm p-3 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 40px; height: 40px; font-size: 13px;">
                                <div class="logo-square" style="width: 32px; height: 32px; font-size: 12px; margin: 0; background: linear-gradient(135deg, #0288D1, #01579B);">AC</div>
                            </div>
                            <div>
                                <div class="fw-bold text-dark mb-0" style="font-size: 14px;">Pedido #{{this._id}} - {{this.comercioId.nombreComercio}}</div>
                                <small class="text-muted" style="font-size: 12px;">{{formatDate this.updatedAt}} · {{this.productos.length}} productos</small>
                            </div>
                        </div>

                        <div class="text-end">
                            <div class="fw-bold mb-1" style="color: #E91E63; font-size: 14px;">RD${{money this.total}}</div>
                            <span class="badge badge-status-completado">
                                Completado
                            </span>
                        </div>
                    </div>
                </div>
            {{else}}
                <div class="card border-0 shadow-sm p-4 text-center rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <p class="text-muted mb-0 small">No has completado entregas todavía.</p>
                </div>
            {{/each}}
        </div>
    </div>
</div>
