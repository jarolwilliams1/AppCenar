<div class="app-container" style="max-width: 580px;">
    <h3 class="fw-bold mb-4 text-center" style="color: #1A1A2E; font-size: 22px;">Mi Perfil</h3>

    {{#if successMsg}}
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{successMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    {{#if errorMsg}}
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert">
            {{errorMsg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/if}}

    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <form action="/delivery/perfil" method="POST" enctype="multipart/form-data">
            <!-- Foto de perfil avatar -->
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-2 text-white" 
                     style="width: 76px; height: 76px; background: linear-gradient(135deg, #0288D1, #01579B); font-size: 32px; overflow: hidden; box-shadow: 0 4px 12px rgba(2, 136, 209, 0.2);">
                    {{#if delivery.fotoPerfil}}
                        <img src="{{delivery.fotoPerfil}}" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
                    {{else}}
                        🛵
                    {{/if}}
                </div>
                <div>
                    <label for="fotoPerfil" class="btn btn-link p-0 text-decoration-none" style="color: #0288D1; font-size: 12.5px; font-weight: 500; cursor: pointer;">
                        Cambiar foto
                    </label>
                    <input type="file" id="fotoPerfil" name="fotoPerfil" class="d-none" accept="image/*">
                </div>
                <div class="mt-2">
                    <span class="badge rounded-pill px-3 py-1" style="{{#if (eq delivery.estadoDelivery "Disponible")}}background-color: #E8F5E9; color: #2E7D32;{{else}}background-color: #FFEBEE; color: #C62828;{{/if}} font-size: 12px;">
                        {{#if (eq delivery.estadoDelivery "Disponible")}}🟢 Disponible{{else}}🔴 Ocupado{{/if}}
                    </span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Nombre</label>
                    <input type="text" name="nombre" class="form-control" value="{{delivery.nombre}}" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Apellido</label>
                    <input type="text" name="apellido" class="form-control" value="{{delivery.apellido}}" required style="font-size: 13.5px;">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Teléfono</label>
                    <input type="text" name="telefono" class="form-control" value="{{delivery.telefono}}" required style="font-size: 13.5px;">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">Nombre de usuario</label>
                    <input type="text" class="form-control bg-light" value="{{delivery.usuario}}" disabled readonly style="font-size: 13.5px;">
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-muted small fw-semibold">Correo</label>
                <input type="email" class="form-control bg-light" value="{{delivery.correo}}" disabled readonly style="font-size: 13.5px;">
            </div>

            <div>
                <button type="submit" class="btn-pink-primary w-100 py-2" style="font-size: 14px;">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>
