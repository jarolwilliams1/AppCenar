<div class="app-container" style="max-width: 680px;">
    <div class="mb-3">
        <a href="/delivery/home" class="back-link">
            ← Volver a asignaciones
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4 rounded-4 mb-4" style="background: #FFFFFF; border: 1px solid #EEF2F6;">
        <!-- Cabecera -->
        <div class="d-flex justify-content-between align-items-start pb-3 mb-3 border-bottom flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 48px; height: 48px; font-size: 24px;">
                    🍕
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark" style="font-size: 16px;">Pedido #{{pedido._id}}</h5>
                    <small class="text-muted" style="font-size: 12.5px;">{{pedido.comercioId.nombreComercio}} · {{formatDate pedido.createdAt}}</small>
                </div>
            </div>

            <span class="badge {{statusBadge pedido.estado}} rounded-pill px-3 py-1" style="font-size: 11.5px;">
                {{statusLabel pedido.estado}}
            </span>
        </div>

        <!-- Productos -->
        <div class="mb-4">
            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">PRODUCTOS</div>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-1 ps-2">
                {{#each pedido.productos}}
                    <li class="d-flex align-items-center gap-2" style="font-size: 13.5px; color: #374151;">
                        <span>•</span>
                        <span>{{this.nombre}}</span>
                    </li>
                {{/each}}
            </ul>
        </div>

        <!-- Dirección de entrega destacada en azul claro -->
        <div class="p-3 rounded-3 mb-4" style="background-color: #E1F5FE; border-radius: 12px;">
            <div class="fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.05em; color: #0288D1;">📍 DIRECCIÓN DE ENTREGA</div>
            <div class="fw-semibold text-dark" style="font-size: 13.5px;">{{pedido.direccion.nombre}} - {{pedido.direccion.descripcion}}</div>
        </div>

        <!-- Total y Botón Completar Pedido -->
        <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-3">
            <div class="fw-bold" style="color: #E91E63; font-size: 18px;">
                RD${{money pedido.total}}
            </div>

            {{#if esEnProceso}}
                <form action="/delivery/pedidos/{{pedido._id}}/completar" method="POST" class="m-0">
                    <button type="submit" class="btn-success-pill py-2 px-4" style="font-size: 13.5px;">
                        ✅ Completar Pedido
                    </button>
                </form>
            {{/if}}
        </div>
    </div>
</div>
