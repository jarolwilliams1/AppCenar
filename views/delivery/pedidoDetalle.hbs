<section class="container" style="max-width: 800px; margin-top: 90px; margin-bottom: 60px;">
    <div class="d-flex align-items-center mb-4">
        <a href="/delivery/home" class="btn btn-outline-secondary btn-sm rounded-pill px-3 me-3">
            &larr; Volver a asignaciones
        </a>
        <h4 class="fw-bold mb-0" style="color: #1a1a2e;">Detalles de la Entrega</h4>
    </div>

    <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <!-- Cabecera -->
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-light" style="width: 56px; height: 56px; border: 1px solid #eee;">
                    {{#if pedido.comercioId.logoComercio}}
                        <img src="{{pedido.comercioId.logoComercio}}" alt="Logo" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px;">
                    {{else}}
                        <span style="font-size: 28px;">??</span>
                    {{/if}}
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">{{pedido.comercioId.nombreComercio}}</h5>
                    <small class="text-muted">Fecha: {{formatDate pedido.createdAt}}</small>
                </div>
            </div>

            <span class="badge {{statusBadge pedido.estado}} rounded-pill px-3 py-2 text-uppercase" style="font-size: 12px; font-weight: 700;">
                {{statusLabel pedido.estado}}
            </span>
        </div>

        <!-- Botún Completar Pedido si está en_proceso -->
        {{#if esEnProceso}}
            <form action="/delivery/pedidos/{{pedido._id}}/completar" method="POST" class="mb-4">
                <button type="submit" class="btn btn-success w-100 py-3 text-white shadow-sm" style="border-radius: 12px; font-weight: bold; font-size: 16px;">
                    ? Completar Pedido y Liberar Entrega
                </button>
            </form>
        {{/if}}

        <!-- Productos -->
        <div class="mb-4">
            <h6 class="fw-bold text-uppercase text-muted mb-3" style="font-size: 12px; letter-spacing: 0.05em;">Productos del Pedido</h6>
            <div class="d-flex flex-column gap-2">
                {{#each pedido.productos}}
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                        <span class="fw-bold text-dark">{{this.nombre}}</span>
                        <span class="text-muted">RD$ {{money this.precio}}</span>
                    </div>
                {{/each}}
            </div>
        </div>

        <!-- dirección de entrega: VISIBLE SOLO SI EN_PROCESO, OCULTA SI COMPLETADO -->
        {{#if esEnProceso}}
            <div class="p-3 rounded-3 mb-4" style="background-color: #e1f5fe; border: 1px solid #0288D1;">
                <div class="text-primary text-uppercase fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.05em;">?? dirección de Entrega (Cliente)</div>
                <div class="fw-bold text-dark fs-6">{{pedido.direccion.nombre}}</div>
                <div class="text-dark">{{pedido.direccion.descripcion}}</div>
                <div class="mt-2 small text-muted">
                    Cliente: <strong>{{pedido.clienteId.nombre}} {{pedido.clienteId.apellido}}</strong>  ?? {{pedido.clienteId.telefono}}
                </div>
            </div>
        {{else}}
            <div class="alert alert-light border text-muted small py-2 mb-4 text-center rounded-3">
                ?? La dirección de entrega ha sido ocultada porque el pedido ya fue completado.
            </div>
        {{/if}}

        <!-- Total -->
        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <span class="fs-5 fw-bold" style="color: #1a1a2e;">Total del Pedido:</span>
            <span class="fs-4 fw-bold" style="color: #0288D1;">RD$ {{money pedido.total}}</span>
        </div>
    </div>
</section>
