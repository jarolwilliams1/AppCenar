# =================================================================
# AppCenar - Variables de Entorno de Ejemplo
# =================================================================

# Puerto del servidor (Railway asigna PORT dinámicamente)
PORT=3000

# Entorno de ejecución (development | qa | production)
NODE_ENV=production

# Clave secreta para la sesión de Express
SESSION_ENV=tu_clave_secreta_de_sesion_super_segura

# URL pública de la aplicación
BASE_URL=https://tu-app.up.railway.app

# URI de Conexión a MongoDB (MongoDB Atlas o Plugin de Railway)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/AppCenarDB?retryWrites=true&w=majority
MONGO_CONECTION=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/AppCenarDB?retryWrites=true&w=majority

# Configuración de Envío de Correos (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_correo@gmail.com
EMAIL_CLAVE=tu_contrasena_de_aplicacion_de_gmail
